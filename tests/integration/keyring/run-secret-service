#!/usr/bin/env bash
set -euo pipefail

command -v dbus-run-session >/dev/null
command -v dbus-send >/dev/null
command -v gnome-keyring-daemon >/dev/null
command -v python3 >/dev/null
command -v readlink >/dev/null
command -v setsid >/dev/null

service_root="$(mktemp -d)"
service_home="${service_root}/home"
service_runtime="${service_root}/runtime"
service_owner="keyring:${service_root}"
process_helper="$(
  readlink -f -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../../../tools/checks/owned_processes.py"
)"
host_home="${HOME}"
host_bus="${DBUS_SESSION_BUS_ADDRESS-}"
[[ -f "${process_helper}" ]]
mkdir -p "${service_home}" "${service_runtime}"
chmod 0700 "${service_home}" "${service_runtime}"

env \
  HOME="${service_home}" \
  XDG_RUNTIME_DIR="${service_runtime}" \
  CTOWER_TEST_SERVICE_ROOT="${service_root}" \
  CTOWER_TEST_PROCESS_HELPER="${process_helper}" \
  CTOWER_TEST_PROCESS_OWNER="${service_owner}" \
  CTOWER_TEST_HOST_HOME="${host_home}" \
  CTOWER_TEST_HOST_BUS="${host_bus}" \
  dbus-run-session -- bash -euo pipefail -c '
    service_pid=""
    service_pgid=""

    stop_service() {
      local stop_status=0
      local -a candidate_args=()
      if [[ -n "${service_pid}" ]]; then
        candidate_args=(
          --candidate-pid "${service_pid}"
          --candidate-session-id "${service_pid}"
        )
      fi
      if python3 "${CTOWER_TEST_PROCESS_HELPER}" \
        CTOWER_TEST_SERVICE_OWNER \
        "${CTOWER_TEST_PROCESS_OWNER}" \
        --term-grace-seconds 4 \
        --kill-grace-seconds 1 \
        "${candidate_args[@]}"; then
        stop_status=0
      else
        stop_status="$?"
      fi
      [[ -z "${service_pid}" ]] || wait "${service_pid}" 2>/dev/null || true
      [[ "${stop_status}" == "0" ]]
    }

    cleanup() {
      local command_status="$?"
      local cleanup_status=0
      trap - EXIT HUP INT TERM
      stop_service || cleanup_status=1
      find "${CTOWER_TEST_SERVICE_ROOT}" -depth -delete
      if [[ "${command_status}" != "0" ]]; then
        exit "${command_status}"
      fi
      exit "${cleanup_status}"
    }
    trap cleanup EXIT HUP INT TERM

    CTOWER_TEST_SERVICE_OWNER="${CTOWER_TEST_PROCESS_OWNER}" \
      setsid gnome-keyring-daemon \
      --foreground \
      --components=secrets \
      --control-directory="${CTOWER_TEST_SERVICE_ROOT}/control" \
      --unlock \
      <<< "" \
      >"${CTOWER_TEST_SERVICE_ROOT}/daemon.stdout" \
      2>"${CTOWER_TEST_SERVICE_ROOT}/daemon.stderr" &
    service_pid="$!"
    observed_pgid=""
    for _ in {1..100}; do
      service_state="$(ps -o stat= -p "${service_pid}" 2>/dev/null | tr -d " ")"
      [[ -n "${service_state}" && "${service_state:0:1}" != "Z" ]] || break
      observed_pgid="$(ps -o pgid= -p "${service_pid}" 2>/dev/null | tr -d " ")"
      [[ -n "${observed_pgid}" ]] || break
      if [[ "${observed_pgid}" == "${service_pid}" ]]; then
        service_pgid="${observed_pgid}"
        break
      fi
      sleep 0.05
    done
    [[ "${service_pid}" == "${service_pgid}" ]]

    ready=0
    for _ in {1..100}; do
      service_state="$(ps -o stat= -p "${service_pid}" 2>/dev/null | tr -d " ")"
      [[ -n "${service_state}" && "${service_state:0:1}" != "Z" ]] || break
      if dbus-send \
        --session \
        --dest=org.freedesktop.DBus \
        --type=method_call \
        --print-reply \
        / \
        org.freedesktop.DBus.ListNames 2>/dev/null |
        grep -Fq "org.freedesktop.secrets"; then
        ready=1
        break
      fi
      sleep 0.05
    done
    if [[ "${ready}" != "1" ]]; then
      sed -n "1,80p" "${CTOWER_TEST_SERVICE_ROOT}/daemon.stderr" >&2
      exit 1
    fi

    export PYTHON_KEYRING_BACKEND=keyring.backends.SecretService.Keyring
    "$@"
  ' bash "$@"
