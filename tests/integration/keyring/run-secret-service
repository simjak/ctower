#!/usr/bin/env bash
set -euo pipefail

command -v dbus-run-session >/dev/null
command -v dbus-send >/dev/null
command -v gnome-keyring-daemon >/dev/null
command -v setsid >/dev/null

service_root="$(mktemp -d)"
service_home="${service_root}/home"
service_runtime="${service_root}/runtime"
host_home="${HOME}"
host_bus="${DBUS_SESSION_BUS_ADDRESS-}"
mkdir -p "${service_home}" "${service_runtime}"
chmod 0700 "${service_home}" "${service_runtime}"

cleanup_root() {
  [[ ! -e "${service_root}" ]] ||
    find "${service_root}" -depth -delete >/dev/null 2>&1 ||
    true
}
trap cleanup_root EXIT

printf \
  '[ctower-secret-service] stage=session-bus-start root=%s\n' \
  "${service_root}" >&2

env \
  HOME="${service_home}" \
  XDG_RUNTIME_DIR="${service_runtime}" \
  CTOWER_TEST_SERVICE_ROOT="${service_root}" \
  CTOWER_TEST_HOST_HOME="${host_home}" \
  CTOWER_TEST_HOST_BUS="${host_bus}" \
  dbus-run-session -- bash -euo pipefail -c '
    service_pid=""
    service_pgid=""
    service_group_verified=0

    stage() {
      local name="$1"
      shift
      printf "[ctower-secret-service] stage=%s" "${name}" >&2
      if [[ "$#" -gt 0 ]]; then
        printf " %s" "$@" >&2
      fi
      printf "\n" >&2
    }

    service_residue_exists() {
      local process_directory
      local executable
      for process_directory in /proc/[0-9]*; do
        executable="$(readlink -f "${process_directory}/exe" 2>/dev/null || true)"
        [[ "${executable}" == "/usr/bin/gnome-keyring-daemon" ]] || continue
        if tr "\0" "\n" <"${process_directory}/environ" 2>/dev/null |
          grep -Fxq "HOME=${HOME}"; then
          return 0
        fi
      done
      return 1
    }

    service_is_running() {
      local state
      [[ -r "/proc/${service_pid}/stat" ]] || return 1
      state="$(cut -d " " -f 3 "/proc/${service_pid}/stat" 2>/dev/null || true)"
      [[ -n "${state}" && "${state}" != "Z" ]]
    }

    signal_service() {
      local signal_name="$1"
      [[ -n "${service_pid}" ]] || return 0
      if [[ "${service_group_verified}" == "1" ]]; then
        [[ "${service_pgid}" == "${service_pid}" ]]
        kill "-${signal_name}" -- "-${service_pgid}" 2>/dev/null || true
        return
      fi
      kill "-${signal_name}" -- "${service_pid}" 2>/dev/null || true
    }

    verify_service_group() {
      local observed_pgid=""
      for _ in {1..100}; do
        if ! service_is_running; then
          stage daemon-pgid-verification-failed \
            "reason=child-exited" \
            "observed_pgid=${observed_pgid:-unavailable}"
          return 1
        fi
        observed_pgid="$(ps -o pgid= -p "${service_pid}" 2>/dev/null | tr -d " " || true)"
        if [[ "${observed_pgid}" == "${service_pid}" ]]; then
          service_pgid="${observed_pgid}"
          service_group_verified=1
          stage daemon-pgid-verified "pid=${service_pid}" "pgid=${service_pgid}"
          return 0
        fi
        sleep 0.05
      done
      stage daemon-pgid-verification-failed \
        "reason=timeout" \
        "observed_pgid=${observed_pgid:-unavailable}"
      return 1
    }

    stop_service() {
      local cleanup_mode="$1"
      local signal_target="pid:${service_pid}"
      local wait_iterations=50
      [[ "${cleanup_mode}" == "fast" ]] && wait_iterations=2
      if [[ "${service_group_verified}" == "1" ]]; then
        signal_target="group:${service_pgid}"
      fi

      stage cleanup-term "target=${signal_target}"
      signal_service TERM
      for ((iteration = 0; iteration < wait_iterations; iteration += 1)); do
        service_is_running || break
        sleep 0.01
      done
      if service_is_running; then
        stage cleanup-kill "target=${signal_target}"
        signal_service KILL
        if [[ "${cleanup_mode}" == "fast" ]]; then
          for _ in {1..2}; do
            service_is_running || break
            sleep 0.01
          done
        fi
      fi
      if [[ "${cleanup_mode}" == "fast" ]] && service_is_running; then
        stage residue-check
        return 1
      fi
      [[ -z "${service_pid}" ]] || wait "${service_pid}" 2>/dev/null || true

      stage residue-check
      [[ "${cleanup_mode}" == "fast" ]] && return 0
      ! service_residue_exists
    }

    cleanup() {
      local command_status="$1"
      local cleanup_mode="$2"
      local cleanup_status=0
      trap - EXIT HUP INT TERM
      stop_service "${cleanup_mode}" || cleanup_status=1
      find "${CTOWER_TEST_SERVICE_ROOT}" -depth -delete 2>/dev/null ||
        cleanup_status=1
      stage cleanup-complete "command_status=${command_status}"
      if [[ "${command_status}" != "0" ]]; then
        exit "${command_status}"
      fi
      exit "${cleanup_status}"
    }
    trap "cleanup \$? normal" EXIT
    trap "cleanup 129 fast" HUP
    trap "cleanup 130 fast" INT
    trap "cleanup 143 fast" TERM

    stage daemon-spawn
    setsid gnome-keyring-daemon \
      --foreground \
      --components=secrets \
      --control-directory="${CTOWER_TEST_SERVICE_ROOT}/control" \
      --unlock \
      <<< "" \
      >"${CTOWER_TEST_SERVICE_ROOT}/daemon.stdout" \
      2>"${CTOWER_TEST_SERVICE_ROOT}/daemon.stderr" &
    service_pid="$!"
    verify_service_group

    ready=0
    for _ in {1..100}; do
      kill -0 "${service_pid}" 2>/dev/null || break
      if dbus-send \
        --session \
        --dest=org.freedesktop.DBus \
        --type=method_call \
        --print-reply \
        / \
        org.freedesktop.DBus.ListNames 2>/dev/null |
        grep -Fq "org.freedesktop.secrets"; then
        ready=1
        break
      fi
      sleep 0.05
    done
    if [[ "${ready}" != "1" ]]; then
      stage daemon-ready-failed
      sed -n "1,80p" "${CTOWER_TEST_SERVICE_ROOT}/daemon.stderr" >&2
      exit 1
    fi
    stage daemon-ready

    export PYTHON_KEYRING_BACKEND=keyring.backends.SecretService.Keyring
    stage test-command
    set +e
    "$@"
    command_status="$?"
    set -e
    stage test-command-complete "status=${command_status}"
    exit "${command_status}"
  ' bash "$@"
