{
  "name": "@ctower/workspace",
  "private": true,
  "version": "0.31.0",
  "packageManager": "pnpm@10.20.0+sha512-z5mYIiFi3YWGTQqBAueJLnukzq3rv1ox+cL85I384xepxTufZGTR75BCy6LgKuAqn3wUOitDjNk8kYQPAZK53Q==",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format:check": "prettier --check apps/ctower-web/src apps/ctower-web/index.html apps/ctower-web/vite.config.ts apps/ctower-web/package.json apps/ctower-web/tsconfig.json tsconfig.base.json eslint.config.mjs prettier.config.mjs",
    "lint": "eslint apps/ctower-web/src apps/ctower-web/vite.config.ts",
    "typecheck": "pnpm --filter @ctower/web typecheck && pnpm --filter @ctower/client typecheck",
    "build": "pnpm --filter @ctower/web build"
  },
  "devDependencies": {
    "@eslint/js": ">=9.32 <10",
    "eslint": ">=9.32 <10",
    "prettier": ">=3.6 <4",
    "typescript": ">=5.9 <6",
    "typescript-eslint": ">=8.38 <9"
  }
}
