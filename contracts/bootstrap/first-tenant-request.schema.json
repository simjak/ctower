{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/bootstrap/first-tenant-request.schema.json",
  "title": "FirstTenantBootstrapRequest",
  "description": "Secret-free body for the one-use first-tenant trust-root ceremony.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tenant", "initial_operator", "durable_commander", "vault_binding_refs"],
  "properties": {
    "schema": { "const": "ctower.bootstrap.first-tenant-request/v1" },
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "display_name"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "initial_operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["external_subject", "display_name"],
      "properties": {
        "external_subject": { "type": "string", "minLength": 1, "maxLength": 255 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "durable_commander": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "display_name"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "vault_binding_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reference_class", "reference"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$" },
          "reference_class": {
            "type": "string",
            "enum": ["os-credential", "vault-path", "runtime-binding"]
          },
          "reference": {
            "type": "string",
            "pattern": "^(?:os-credential|vault|binding)://[^\\s]+$",
            "maxLength": 512
          }
        }
      }
    }
  }
}
