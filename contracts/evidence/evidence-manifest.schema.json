{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.invalid/contracts/evidence/evidence-manifest.schema.json",
  "title": "EvidenceManifestConsumerSubset",
  "description": "Development-only CP-1 typed evidence denominator: every applicable I1 criterion has exactly one disposition and every deferred capability is a keyed row derived from the capability/expected-suite registries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "tenant_id",
    "ticket_id",
    "candidate_digest",
    "criteria_revision",
    "criteria",
    "verdict_ids",
    "deferred_capabilities"
  ],
  "properties": {
    "schema": {"const": "ctower.evidence-manifest/v1"},
    "status": {"const": "development_only"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "ticket_id": {"type": "string", "format": "uuid"},
    "candidate_digest": {"$ref": "#/$defs/sha256"},
    "criteria_revision": {"type": "integer", "minimum": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/criterionDisposition"}
    },
    "verdict_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uuid"}
    },
    "deferred_capabilities": {
      "type": "array",
      "items": {"$ref": "#/$defs/deferredCapability"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableKey": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "disposition": {
      "type": "string",
      "enum": [
        "applicable",
        "satisfied_by_superseding_evidence",
        "deferred",
        "failed"
      ]
    },
    "criterionDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_key",
        "disposition",
        "reason",
        "owner",
        "source_sha",
        "environment",
        "proof_digest",
        "verifier",
        "applicability_reason"
      ],
      "properties": {
        "criterion_key": { "$ref": "#/$defs/stableKey" },
        "disposition": { "$ref": "#/$defs/disposition" },
        "reason": { "type": "string", "minLength": 1 },
        "owner": { "$ref": "#/$defs/stableKey" },
        "source_sha": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "proof_digest": { "$ref": "#/$defs/sha256" },
        "verifier": { "type": "string", "format": "uuid" },
        "applicability_reason": { "type": "string", "minLength": 1 }
      }
    },
    "deferredCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_key",
        "status",
        "source_count",
        "reason"
      ],
      "properties": {
        "capability_key": {"$ref": "#/$defs/stableKey"},
        "status": {"const": "not_exercised"},
        "source_count": {"const": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
