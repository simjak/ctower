{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.invalid/contracts/evidence/evidence-manifest.schema.json",
  "title": "EvidenceManifestConsumerSubset",
  "description": "Development-only CP-1 typed evidence denominator. The criterion denominator is derived from two registries of record — the frozen gate-policy criteria and the acceptance-criterion codes the traceability generator reads — and every derived criterion carries exactly one typed disposition. The deferred denominator is derived from the deferred suites of the expected-suite registry; capability components are not a denominator source, so an exercised capability is never forced to declare itself unexercised. Criterion keys, acceptance-criterion codes and suite ids each keep their own namespace.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "tenant_id",
    "ticket_id",
    "candidate_digest",
    "criteria_revision",
    "criteria",
    "verdict_ids",
    "deferred_suites"
  ],
  "properties": {
    "schema": {"const": "ctower.evidence-manifest/v1"},
    "status": {"const": "development_only"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "ticket_id": {"type": "string", "format": "uuid"},
    "candidate_digest": {"$ref": "#/$defs/sha256"},
    "criteria_revision": {"type": "integer", "minimum": 1},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/criterionDisposition"}
    },
    "verdict_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uuid"}
    },
    "deferred_suites": {
      "type": "array",
      "items": {"$ref": "#/$defs/deferredSuite"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "suiteId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "ownerTicket": {"type": "string", "pattern": "^ct-(?:l0|i[1-9][0-9]*)-[0-9]{3}$"},
    "gatePolicyCriterionKey": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "acceptanceCriterionCode": {"type": "string", "pattern": "^AC-[A-Z]{2,8}-[0-9]{2}$"},
    "criterionSource": {
      "type": "string",
      "enum": ["gate-policy", "acceptance-criterion"]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "applicable",
        "satisfied_by_superseding_evidence",
        "deferred",
        "failed"
      ]
    },
    "criterionDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_source",
        "criterion_key",
        "disposition",
        "reason",
        "owner",
        "source_sha",
        "environment",
        "proof_digest",
        "verifier"
      ],
      "properties": {
        "criterion_source": {"$ref": "#/$defs/criterionSource"},
        "criterion_key": {"type": "string", "minLength": 1},
        "disposition": {"$ref": "#/$defs/disposition"},
        "reason": {"type": "string", "minLength": 1},
        "owner": {"$ref": "#/$defs/ownerTicket"},
        "source_sha": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "proof_digest": {"$ref": "#/$defs/sha256"},
        "verifier": {"type": "string", "format": "uuid"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"criterion_source": {"const": "gate-policy"}},
            "required": ["criterion_source"]
          },
          "then": {
            "properties": {"criterion_key": {"$ref": "#/$defs/gatePolicyCriterionKey"}}
          }
        },
        {
          "if": {
            "properties": {"criterion_source": {"const": "acceptance-criterion"}},
            "required": ["criterion_source"]
          },
          "then": {
            "properties": {"criterion_key": {"$ref": "#/$defs/acceptanceCriterionCode"}}
          }
        }
      ]
    },
    "deferredSuite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "status",
        "source_count",
        "reason"
      ],
      "properties": {
        "suite_id": {"$ref": "#/$defs/suiteId"},
        "status": {"const": "not_exercised"},
        "source_count": {"const": 0},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
