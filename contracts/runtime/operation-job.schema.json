{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/runtime/operation-job.schema.json",
  "title": "FixedOperationJob",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "job_id", "tenant_id", "occurrence_id", "operation", "state",
    "timeout_seconds", "component_digests", "created_at"
  ],
  "properties": {
    "schema_id": {"const": "ctower.operation-job/v1"},
    "job_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "occurrence_id": {"type": "string", "format": "uuid"},
    "operation": {"type": "string", "enum": ["synthetic_four_stage", "daily_backup", "record_anchor"]},
    "state": {"const": "pending"},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "component_digests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  }
}
