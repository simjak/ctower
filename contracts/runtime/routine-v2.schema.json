{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/runtime/routine-v2.schema.json",
  "title": "DreamRoutineRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "routine_ref", "revision_digest", "schedule", "dst_policy",
    "concurrency", "catch_up", "catch_up_cap", "timeout_seconds", "handler_kind",
    "component_digests", "dream_dispatch"
  ],
  "properties": {
    "schema_id": {"const": "ctower.routine/v2"},
    "routine_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*@[1-9][0-9]*$"},
    "revision_digest": {
      "allOf": [{"$ref": "#/$defs/digest"}],
      "description": "SHA-256 of canonical UTF-8 JSON for every authored field except revision_digest; object keys sorted and separators comma/colon."
    },
    "schedule": {"$ref": "#/$defs/schedule"},
    "dst_policy": {"const": "wall_clock_once"},
    "concurrency": {"const": "always_enqueue_bounded"},
    "catch_up": {"const": "skip_missed"},
    "catch_up_cap": {"const": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "handler_kind": {"const": "dream_dispatch"},
    "component_digests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "dream_dispatch": {"$ref": "#/$defs/dreamDispatch"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableKey": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "timezone", "local_time"],
      "properties": {
        "kind": {"const": "daily"},
        "timezone": {"const": "UTC"},
        "local_time": {"type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"}
      }
    },
    "modelSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_ref", "reasoning_effort"],
      "properties": {
        "model_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "reasoning_effort": {"const": "max"}
      }
    },
    "modelRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallback", "minimum_tier", "excluded_families"],
      "properties": {
        "primary": {"$ref": "#/$defs/modelSelection"},
        "fallback": {"$ref": "#/$defs/modelSelection"},
        "minimum_tier": {"const": "hard"},
        "excluded_families": {
          "type": "array", "const": ["claude"]
        }
      }
    },
    "dreamDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_kind", "project_key", "skill_path", "model_requirement"],
      "properties": {
        "scope_kind": {"enum": ["project", "fleet"]},
        "project_key": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9._-]*$"},
        "skill_path": {"const": "skills/dreamer/SKILL.md"},
        "model_requirement": {"$ref": "#/$defs/modelRequirement"}
      },
      "oneOf": [
        {
          "properties": {
            "scope_kind": {"const": "project"},
            "project_key": {"$ref": "#/$defs/stableKey"}
          }
        },
        {
          "properties": {
            "scope_kind": {"const": "fleet"},
            "project_key": {"type": "null"}
          }
        }
      ]
    }
  }
}
