{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/runtime/beat-dispatch-effect.schema.json",
  "title": "BeatDispatchEffect",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effect_id", "occurrence_id", "routine_ref", "revision_digest", "scheduled_for",
    "beat_key", "prompt_source", "prompt_sha256", "prompt", "target_session", "emitted_at"
  ],
  "properties": {
    "effect_id": {"type": "string", "format": "uuid"},
    "occurrence_id": {"type": "string", "format": "uuid"},
    "routine_ref": {"type": "string", "pattern": "^ctower\\.beat\\.[a-z][a-z0-9._-]*@[1-9][0-9]*$"},
    "revision_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scheduled_for": {"type": "string", "format": "date-time"},
    "beat_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "prompt_source": {"type": "string", "pattern": "^state/beats/[a-z][a-z0-9._-]*\\.txt$"},
    "prompt_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "prompt": {"type": "string", "minLength": 1, "maxLength": 16384},
    "target_session": {"enum": ["commander", "mc-commander-manibo"]},
    "emitted_at": {"type": "string", "format": "date-time"}
  }
}
