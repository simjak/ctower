{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/runtime/routine-v4.schema.json",
  "title": "RoutineWorkItemRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id", "routine_ref", "revision_digest", "schedule", "dst_policy",
    "concurrency", "catch_up", "catch_up_cap", "timeout_seconds", "handler_kind",
    "component_digests", "activity_gate", "routine_item"
  ],
  "properties": {
    "schema_id": {"const": "ctower.routine/v4"},
    "routine_ref": {"type": "string", "pattern": "^mc-cron\\.[a-z][a-z0-9._-]*@[1-9][0-9]*$"},
    "revision_digest": {"$ref": "#/$defs/digest"},
    "schedule": {"$ref": "#/$defs/schedule"},
    "dst_policy": {"const": "wall_clock_once"},
    "concurrency": {"const": "always_enqueue_bounded"},
    "catch_up": {"const": "skip_missed"},
    "catch_up_cap": {"const": 1},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "handler_kind": {"const": "routine_item"},
    "component_digests": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "activity_gate": {"$ref": "#/$defs/activityGate"},
    "routine_item": {"$ref": "#/$defs/routineItem"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stableKey": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "timezone", "minutes", "hours"],
      "properties": {
        "kind": {"const": "minute_hour_set"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 128},
        "minutes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 59}
        },
        "hours": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "minItems": 1, "uniqueItems": true,
             "items": {"type": "integer", "minimum": 0, "maximum": 23}}
          ]
        }
      }
    },
    "activityGate": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["always", "new_movement_since_watermark", "open_tickets_above"]},
        "source": {"enum": ["events", "tickets"]},
        "threshold": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "project_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "always"}}},
          "then": {
            "properties": {"source": false, "threshold": false, "project_key": false}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "new_movement_since_watermark"}}},
          "then": {
            "required": ["source"],
            "properties": {"threshold": false, "project_key": false}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "open_tickets_above"}}},
          "then": {
            "required": ["threshold"],
            "properties": {"source": false}
          }
        }
      ]
    },
    "routineItem": {
      "type": "object", "additionalProperties": false,
      "required": ["item_key", "knowledge_ref", "document_id", "owner_seat", "escalation_seat"],
      "properties": {
        "item_key": {"$ref": "#/$defs/stableKey"},
        "knowledge_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
        "document_id": {"type": "string", "format": "uuid"},
        "owner_seat": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"},
        "escalation_seat": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"}
      }
    }
  }
}
