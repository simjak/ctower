{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/domain/events/event-envelope.schema.json",
  "title": "CtowerEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actor_principal_id",
    "aggregate_id",
    "causation_id",
    "client_command_id",
    "correlation_id",
    "event_id",
    "kind",
    "origin",
    "payload",
    "prev_hash",
    "request_sha256",
    "schema_version",
    "sequence",
    "server_time",
    "stream_id",
    "tenant_id"
  ],
  "properties": {
    "actor_principal_id": {"type": "string", "format": "uuid"},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "client_command_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "event_id": {"type": "string", "format": "uuid"},
    "kind": {
      "type": "string",
      "enum": [
        "bootstrap.first_tenant_created",
        "ticket.created",
        "ticket.custody_transferred",
        "ticket.comment_added",
        "catalog.component_published",
        "catalog.bundle_activated",
        "work.changed",
        "proof.changed",
        "workflow.changed",
        "routine.occurrence_recorded",
        "attention.poison_disposition_recorded",
        "intake.inbound_event_recorded",
        "intake.inbound_event_promoted"
      ]
    },
    "origin": {"type": "string", "enum": ["api", "bootstrap", "control_worker"]},
    "payload": {"type": "object"},
    "prev_hash": {"$ref": "#/$defs/sha256"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "server_time": {"type": "string", "format": "date-time"},
    "stream_id": {
      "type": "string",
      "pattern": "^(tenant:[0-9a-f-]{36}:bootstrap|ticket:[0-9a-f-]{36}|catalog:[0-9a-f-]{36}|proof:[0-9a-f-]{36}|workflow:[0-9a-f-]{36}|routine-occurrence:[0-9a-f-]{36}|poison-disposition:[0-9a-f-]{36}|inbound-thread:[0-9a-f-]{36})$"
    },
    "tenant_id": {"type": "string", "format": "uuid"}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "kind": {"const": "work.changed"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^ticket:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/workChanged"}
          }
        },
        {
          "properties": {
            "kind": {"const": "bootstrap.first_tenant_created"},
            "origin": {"const": "bootstrap"},
            "stream_id": {"pattern": "^tenant:[0-9a-f-]{36}:bootstrap$"},
            "payload": {"$ref": "#/$defs/bootstrapCreated"}
          }
        },
        {
          "properties": {
            "kind": {"const": "ticket.created"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^ticket:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/ticketCreated"}
          }
        },
        {
          "properties": {
            "kind": {"const": "ticket.custody_transferred"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^ticket:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/custodyTransferred"}
          }
        },
        {
          "properties": {
            "kind": {"const": "ticket.comment_added"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^ticket:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/ticketCommentAdded"}
          }
        },
        {
          "properties": {
            "kind": {"const": "catalog.component_published"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^catalog:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/catalogComponentPublished"}
          }
        },
        {
          "properties": {
            "kind": {"const": "catalog.bundle_activated"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^catalog:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/catalogBundleActivated"}
          }
        },
        {
          "properties": {
            "kind": {"const": "proof.changed"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^proof:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/proofChanged"}
          }
        },
        {
          "properties": {
            "kind": {"const": "workflow.changed"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^workflow:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/workflowChanged"}
          }
        },
        {
          "properties": {
            "kind": {"const": "routine.occurrence_recorded"},
            "origin": {"const": "control_worker"},
            "stream_id": {"pattern": "^routine-occurrence:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/routineOccurrenceRecorded"}
          }
        },
        {
          "properties": {
            "kind": {"const": "attention.poison_disposition_recorded"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^poison-disposition:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/poisonDispositionRecorded"}
          }
        },
        {
          "properties": {
            "kind": {"const": "intake.inbound_event_recorded"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^inbound-thread:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/inboundEventRecorded"}
          }
        },
        {
          "properties": {
            "kind": {"const": "intake.inbound_event_promoted"},
            "origin": {"const": "api"},
            "stream_id": {"pattern": "^inbound-thread:[0-9a-f-]{36}$"},
            "payload": {"$ref": "#/$defs/inboundEventPromoted"}
          }
        }
      ]
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "bootstrapCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commander_id",
        "commander_vault_ref",
        "operator_credential_ref",
        "operator_id",
        "operator_vault_ref",
        "tenant_id",
        "tenant_slug"
      ],
      "properties": {
        "commander_id": {"type": "string", "format": "uuid"},
        "commander_vault_ref": {"type": "string", "minLength": 1},
        "operator_credential_ref": {"type": "string", "minLength": 1},
        "operator_id": {"type": "string", "format": "uuid"},
        "operator_vault_ref": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "format": "uuid"},
        "tenant_slug": {"type": "string", "minLength": 2, "maxLength": 63}
      }
    },
    "ticketCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["custodian_id", "priority", "source_kind", "source_ref", "title"],
      "properties": {
        "custodian_id": {"type": "string", "format": "uuid"},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
        "source_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "title": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "custodyTransferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_custodian_id", "reason", "to_custodian_id"],
      "properties": {
        "from_custodian_id": {"type": "string", "format": "uuid"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "to_custodian_id": {"type": "string", "format": "uuid"}
      }
    },
    "ticketCommentAdded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "comment_id", "ticket_id"],
      "properties": {
        "body": {"type": "string", "minLength": 1, "maxLength": 4000},
        "comment_id": {"type": "string", "format": "uuid"},
        "ticket_id": {"type": "string", "format": "uuid"}
      }
    },
    "componentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_digest", "key", "kind", "revision"],
      "properties": {
        "content_digest": {"$ref": "#/$defs/sha256"},
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
        "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "catalogComponentPublished": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "object_version", "payload_ref"],
      "properties": {
        "component": {"$ref": "#/$defs/componentReference"},
        "object_version": {"type": "string", "minLength": 1, "maxLength": 256},
        "payload_ref": {"type": "string", "pattern": "^object:sha256:[0-9a-f]{64}$"}
      }
    },
    "catalogBundleActivated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_version",
        "bundle_digest",
        "member_event_ids",
        "plan_digest"
      ],
      "properties": {
        "active_version": {"type": "integer", "minimum": 1},
        "bundle_digest": {"$ref": "#/$defs/sha256"},
        "member_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "format": "uuid"}
        },
        "plan_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "proofChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_digest",
        "invalidated_evidence_ids",
        "invalidated_verdict_ids",
        "operation",
        "proof_version",
        "ticket_id"
      ],
      "properties": {
        "candidate_digest": {"$ref": "#/$defs/sha256"},
        "invalidated_evidence_ids": {
          "type": "array",
          "items": {"type": "string", "format": "uuid"}
        },
        "invalidated_verdict_ids": {
          "type": "array",
          "items": {"type": "string", "format": "uuid"}
        },
        "operation": {
          "enum": ["freeze_criteria", "record_evidence", "record_verdict", "change_candidate"]
        },
        "proof_version": {"type": "integer", "minimum": 1},
        "ticket_id": {"type": "string", "format": "uuid"}
      }
    },
    "workflowChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle_facts",
        "operation",
        "stage",
        "ticket_id",
        "workflow_ref",
        "workflow_version"
      ],
      "properties": {
        "lifecycle_facts": {
          "oneOf": [
            {"type": "array", "maxItems": 0},
            {"const": ["resolved", "closed"]}
          ]
        },
        "operation": {"enum": ["start", "transition", "resolve_close"]},
        "stage": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "ticket_id": {"type": "string", "format": "uuid"},
        "workflow_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]*@[1-9][0-9]*$"
        },
        "workflow_version": {"type": "integer", "minimum": 1}
      }
    },
    "routineOccurrenceRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id", "local_civil_time", "occurrence_id", "offset_decision", "outcome",
        "revision_digest", "routine_ref", "scheduled_for", "timezone", "utc_offset_seconds"
      ],
      "properties": {
        "job_id": {"type": ["string", "null"], "format": "uuid"},
        "local_civil_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"},
        "occurrence_id": {"type": "string", "format": "uuid"},
        "offset_decision": {"enum": ["exact", "earlier_offset", "nonexistent_local_time"]},
        "outcome": {"enum": ["queued", "coalesced", "skipped", "refused"]},
        "revision_digest": {"$ref": "#/$defs/sha256"},
        "routine_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*@[1-9][0-9]*$"},
        "scheduled_for": {"type": "string", "format": "date-time"},
        "timezone": {"type": "string", "minLength": 1, "maxLength": 128},
        "utc_offset_seconds": {"type": ["integer", "null"], "minimum": -64800, "maximum": 64800}
      }
    },
    "poisonDispositionRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "consumer_key", "outbox_id", "reason", "topic"],
      "properties": {
        "action": {"enum": ["retry", "tombstone"]},
        "consumer_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
        "outbox_id": {"type": "string", "format": "uuid"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "topic": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
      }
    },
    "inboundEventRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_digest",
        "inbound_event_id",
        "intent",
        "outcome",
        "position",
        "project_key",
        "source_kind",
        "source_ref",
        "taint",
        "ticket_id"
      ],
      "properties": {
        "content_digest": {"$ref": "#/$defs/sha256"},
        "inbound_event_id": {"type": "string", "format": "uuid"},
        "intent": {"enum": ["discussion", "create_ticket", "link_ticket"]},
        "outcome": {
          "enum": ["discussion", "ticket_created", "ticket_linked", "quarantined"]
        },
        "position": {"type": "integer", "minimum": 1},
        "project_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "source_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "taint": {
          "enum": ["authenticated", "external_untrusted", "quarantine_required"]
        },
        "ticket_id": {"type": ["string", "null"], "format": "uuid"}
      }
    },
    "inboundEventPromoted": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbound_event_id",
        "intent",
        "outcome",
        "project_key",
        "source_kind",
        "source_ref",
        "ticket_id"
      ],
      "properties": {
        "inbound_event_id": {"type": "string", "format": "uuid"},
        "intent": {"enum": ["create_ticket", "link_ticket"]},
        "outcome": {"enum": ["ticket_created", "ticket_linked"]},
        "project_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "source_kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "ticket_id": {"type": "string", "format": "uuid"}
      }
    },
    "workChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "operation", "ticket_id", "work_version"],
      "properties": {
        "data": {"type": "object"},
        "operation": {
          "enum": [
            "priority_changed", "assignment_changed", "admitted", "deferred",
            "blocker_opened", "blocker_resolved", "reopened", "relation_added"
          ]
        },
        "ticket_id": {"type": "string", "format": "uuid"},
        "work_version": {"type": "integer", "minimum": 2}
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "operation": {"const": "priority_changed"},
                "data": {"$ref": "#/$defs/priorityChanged"}
              }
            },
            {
              "properties": {
                "operation": {"const": "assignment_changed"},
                "data": {"$ref": "#/$defs/assignmentChanged"}
              }
            },
            {
              "properties": {
                "operation": {"const": "admitted"},
                "data": {"$ref": "#/$defs/admissionChanged"}
              }
            },
            {
              "properties": {
                "operation": {"const": "deferred"},
                "data": {"$ref": "#/$defs/deferred"}
              }
            },
            {
              "properties": {
                "operation": {"const": "blocker_opened"},
                "data": {"$ref": "#/$defs/blockerOpened"}
              }
            },
            {
              "properties": {
                "operation": {"const": "blocker_resolved"},
                "data": {"$ref": "#/$defs/blockerResolved"}
              }
            },
            {
              "properties": {
                "operation": {"const": "reopened"},
                "data": {"$ref": "#/$defs/reopened"}
              }
            },
            {
              "properties": {
                "operation": {"const": "relation_added"},
                "data": {"$ref": "#/$defs/relationAdded"}
              }
            }
          ]
        }
      ]
    },
    "priorityChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "from_priority", "policy_ref", "reason", "to_priority", "urgent_evidence_ref"],
      "properties": {
        "authority": {"enum": ["commander", "operator"]},
        "from_priority": {"enum": ["P0", "P1", "P2"]},
        "policy_ref": {"const": "ctower.priority-authority@1"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "to_priority": {"enum": ["P0", "P1", "P2"]},
        "urgent_evidence_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256}
      }
    },
    "assignmentChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_kind", "from_principal_id", "reason", "scope_ref", "to_principal_id"],
      "properties": {
        "assignment_kind": {"enum": ["current_assignee", "stage_owner", "reviewer_assignment"]},
        "from_principal_id": {"type": ["string", "null"], "format": "uuid"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "scope_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
        "to_principal_id": {"type": "string", "format": "uuid"}
      }
    },
    "admissionChanged": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_number", "reason"],
      "properties": {
        "episode_number": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "deferred": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_number", "reason", "review_after"],
      "properties": {
        "episode_number": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "review_after": {"type": "string", "format": "date-time"}
      }
    },
    "blockerOpened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "board_impact", "reason"],
      "properties": {
        "blocker_id": {"type": "string", "format": "uuid"},
        "board_impact": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "blockerResolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker_id", "reason", "resolution_evidence_ref"],
      "properties": {
        "blocker_id": {"type": "string", "format": "uuid"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "resolution_evidence_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "reopened": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episode_number", "priority", "reason"],
      "properties": {
        "episode_number": {"type": "integer", "minimum": 2},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "relationAdded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation_kind", "reason", "target_ticket_id"],
      "properties": {
        "relation_kind": {"enum": ["parent_of", "depends_on", "blocks", "duplicates", "relates_to", "caused_by"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "target_ticket_id": {"type": "string", "format": "uuid"}
      }
    }
  }
}
