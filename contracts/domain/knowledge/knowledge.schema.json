{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/domain/knowledge/knowledge.schema.json",
  "title": "Ctower registered knowledge document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "document_id",
    "tenant_id",
    "scope",
    "project_key",
    "title",
    "body",
    "source_ref",
    "registered_by",
    "registered_at"
  ],
  "properties": {
    "schema": {"const": "ctower.knowledge-document/v1"},
    "document_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "scope": {"type": "string", "enum": ["org", "project"]},
    "project_key": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 1024},
    "body": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "source_ref": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "registered_by": {"type": "string", "format": "uuid"},
    "registered_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"scope": {"const": "org"}}},
      "then": {"properties": {"project_key": {"type": "null"}}},
      "else": {"properties": {"project_key": {"type": "string"}}}
    }
  ]
}
