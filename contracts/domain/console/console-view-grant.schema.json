{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/domain/console/console-view-grant.schema.json",
  "title": "ConsoleViewGrant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "console_session_id",
    "expires_at",
    "grant_id",
    "maximum_uses",
    "not_before",
    "policy_revision",
    "project_key",
    "renewed_from_grant_id"
  ],
  "properties": {
    "console_session_id": {"type": "string", "format": "uuid"},
    "expires_at": {"type": "string", "format": "date-time"},
    "grant_id": {"type": "string", "format": "uuid"},
    "maximum_uses": {"type": "integer", "const": 1},
    "not_before": {"type": "string", "format": "date-time"},
    "policy_revision": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
    "project_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
    "renewed_from_grant_id": {"type": ["string", "null"], "format": "uuid"}
  }
}
