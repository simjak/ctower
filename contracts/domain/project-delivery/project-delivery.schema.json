{
  "$defs": {
    "criteriaCoverage": {
      "additionalProperties": false,
      "properties": {
        "proven": {
          "minimum": 0,
          "type": "integer"
        },
        "declared": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "proven",
        "declared"
      ],
      "type": "object"
    },
    "row": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_key": {
          "pattern": "^I[12]\\.[0-9]+$",
          "type": "string"
        },
        "checkpoint_label": {
          "minLength": 1,
          "type": "string"
        },
        "headline_state": {
          "enum": [
            "planned",
            "in_progress",
            "ready_to_land",
            "merged",
            "verified",
            "released",
            "blocked",
            "done"
          ],
          "type": "string"
        },
        "underlying_maturity": {
          "enum": [
            "planned",
            "in_progress",
            "ready_to_land",
            "merged",
            "verified",
            "released"
          ],
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "type": "string"
        },
        "accountable_owner": {
          "minLength": 1,
          "type": "string"
        },
        "criteria": {
          "$ref": "#/$defs/criteriaCoverage"
        },
        "source_watermark": {
          "minimum": 0,
          "type": "integer"
        },
        "projection_watermark": {
          "minimum": 0,
          "type": "integer"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "development_degraded",
            "disaster_safe",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "health": {
          "enum": [
            "CP3_D_NOT_PROVEN",
            "CURRENT",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "derivation_reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "checkpoint_key",
        "checkpoint_label",
        "headline_state",
        "underlying_maturity",
        "outcome",
        "accountable_owner",
        "criteria",
        "source_watermark",
        "projection_watermark",
        "freshness",
        "confidence",
        "health",
        "source_ids",
        "derivation_reasons"
      ],
      "type": "object"
    }
  },
  "$id": "https://ctower.dev/contracts/domain/project-delivery/project-delivery.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ctower.project-delivery/v1"
    },
    "company_key": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "project_key": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/row"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "company_key",
    "project_key",
    "rows"
  ],
  "title": "compact read-only Project Delivery projection",
  "type": "object"
}
