{
  "$defs": {
    "criteriaCoverage": {
      "additionalProperties": false,
      "properties": {
        "proven": {
          "minimum": 0,
          "type": "integer"
        },
        "declared": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "proven",
        "declared"
      ],
      "type": "object"
    },
    "row": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "checkpoint_label": {
          "minLength": 1,
          "type": "string"
        },
        "headline_state": {
          "enum": [
            "planned",
            "in_progress",
            "ready_to_land",
            "merged",
            "verified",
            "released",
            "blocked",
            "done"
          ],
          "type": "string"
        },
        "underlying_maturity": {
          "enum": [
            "planned",
            "in_progress",
            "ready_to_land",
            "merged",
            "verified",
            "released"
          ],
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "type": "string"
        },
        "accountable_owner": {
          "minLength": 1,
          "type": "string"
        },
        "criteria": {
          "$ref": "#/$defs/criteriaCoverage"
        },
        "qualifying_stage_slots_filled": {
          "minimum": 0,
          "type": "integer"
        },
        "qualifying_stage_slots_required": {
          "minimum": 0,
          "type": "integer"
        },
        "qualifying_stage_unfilled_or_unknown_slot_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9._-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "source_watermark": {
          "minimum": 0,
          "type": "integer"
        },
        "projection_watermark": {
          "minimum": 0,
          "type": "integer"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "development_degraded",
            "disaster_safe",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "health": {
          "enum": [
            "CP3_D_NOT_PROVEN",
            "CURRENT",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "durability": {
          "enum": [
            "CP3_D_NOT_PROVEN",
            "CP3_D_PROVEN",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "recovery": {
          "enum": [
            "EXTERNAL_FAILURE_DOMAIN_UNPROVEN",
            "EXTERNAL_FAILURE_DOMAIN_PROVEN",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "data_class": {
          "enum": [
            "RECONSTRUCTIBLE_ONLY",
            "DISASTER_SAFE_CTOWER_ENGINEERING",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "semantic_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "reconciled_at": {
          "format": "date-time",
          "type": "string"
        },
        "freshness_due_at": {
          "format": "date-time",
          "type": "string"
        },
        "rebuild_generation": {
          "minimum": 0,
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "derivation_reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "checkpoint_key",
        "checkpoint_label",
        "headline_state",
        "underlying_maturity",
        "outcome",
        "accountable_owner",
        "criteria",
        "qualifying_stage_slots_filled",
        "qualifying_stage_slots_required",
        "qualifying_stage_unfilled_or_unknown_slot_keys",
        "source_watermark",
        "projection_watermark",
        "freshness",
        "confidence",
        "health",
        "durability",
        "recovery",
        "data_class",
        "semantic_digest",
        "reconciled_at",
        "freshness_due_at",
        "rebuild_generation",
        "source_ids",
        "derivation_reasons"
      ],
      "type": "object",
      "allOf": [
        {
          "$comment": "A stale or unknown projection cannot advertise current health.",
          "if": {
            "properties": {
              "freshness": {
                "enum": [
                  "stale",
                  "STATE_UNKNOWN"
                ]
              }
            },
            "required": [
              "freshness"
            ]
          },
          "then": {
            "properties": {
              "health": {
                "enum": [
                  "CP3_D_NOT_PROVEN",
                  "STATE_UNKNOWN"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$id": "https://ctower.dev/contracts/domain/project-delivery/project-delivery.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ctower.project-delivery/v1"
    },
    "company_key": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "project_key": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "source_record_position": {
      "minimum": 0,
      "type": "integer"
    },
    "projection_record_position": {
      "minimum": 0,
      "type": "integer"
    },
    "reconciled_at": {
      "format": "date-time",
      "type": "string"
    },
    "freshness_due_at": {
      "format": "date-time",
      "type": "string"
    },
    "projection_semantic_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "rebuild_generation": {
      "minimum": 0,
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/row"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "company_key",
    "project_key",
    "source_record_position",
    "projection_record_position",
    "reconciled_at",
    "freshness_due_at",
    "projection_semantic_digest",
    "rebuild_generation",
    "rows"
  ],
  "title": "compact read-only Project Delivery projection",
  "type": "object"
}
