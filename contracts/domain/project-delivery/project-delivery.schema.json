{
  "$defs": {
    "criteriaCoverage": {
      "additionalProperties": false,
      "properties": {
        "proven": {
          "minimum": 0,
          "type": "integer"
        },
        "declared": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "proven",
        "declared"
      ],
      "type": "object"
    },
    "seatCatalogRevision": {
      "additionalProperties": false,
      "properties": {
        "catalog_key": {
          "pattern": "^[a-z][a-z0-9.-]{2,127}$",
          "type": "string"
        },
        "revision": {"minimum": 1, "type": "integer"},
        "content_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": ["catalog_key", "revision", "content_digest"],
      "type": "object"
    },
    "seatIdentity": {
      "additionalProperties": false,
      "properties": {
        "seat_key": {
          "pattern": "^[a-z][a-z0-9._-]{1,95}$",
          "type": "string"
        },
        "seat_label": {"minLength": 1, "type": "string"},
        "catalog_revision": {"$ref": "#/$defs/seatCatalogRevision"}
      },
      "required": ["seat_key", "seat_label", "catalog_revision"],
      "type": "object"
    },
    "seatAssignment": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {"const": "assigned"},
            "seat": {"$ref": "#/$defs/seatIdentity"}
          },
          "required": ["state", "seat"],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {"state": {"const": "unassigned"}},
          "required": ["state"],
          "type": "object"
        }
      ]
    },
    "qualifyingStageSlot": {
      "additionalProperties": false,
      "properties": {
        "slot_key": {
          "pattern": "^[a-z][a-z0-9._-]*$",
          "type": "string"
        },
        "state": {
          "enum": ["filled", "unfilled", "unknown"],
          "type": "string"
        },
        "assigned_seat": {"$ref": "#/$defs/seatAssignment"},
        "signing_seat": {
          "oneOf": [
            {"$ref": "#/$defs/seatIdentity"},
            {"type": "null"}
          ]
        }
      },
      "required": ["slot_key", "state", "assigned_seat", "signing_seat"],
      "type": "object"
    },
    "deliverySurfaceState": {
      "enum": ["declared_present", "declared_absent", "undeclared"],
      "type": "string"
    },
    "deliverySurfaceField": {
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/$defs/deliverySurfaceState"},
        "identity": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 200},
            {"type": "null"}
          ]
        }
      },
      "required": ["state", "identity"],
      "type": "object"
    },
    "deliverySurfaceEnvironments": {
      "additionalProperties": false,
      "properties": {
        "state": {"$ref": "#/$defs/deliverySurfaceState"},
        "environments": {
          "items": {"minLength": 1, "type": "string"},
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["state", "environments"],
      "type": "object"
    },
    "deliverySurface": {
      "additionalProperties": false,
      "properties": {
        "landing_boundary": {"$ref": "#/$defs/deliverySurfaceField"},
        "non_production_environments": {"$ref": "#/$defs/deliverySurfaceEnvironments"},
        "externally_effective_outcome": {"$ref": "#/$defs/deliverySurfaceField"}
      },
      "required": [
        "landing_boundary",
        "non_production_environments",
        "externally_effective_outcome"
      ],
      "type": "object"
    },
    "row": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_key": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "checkpoint_label": {
          "minLength": 1,
          "type": "string"
        },
        "headline_state": {
          "enum": [
            "planned",
            "in_progress",
            "ready_to_land",
            "merged",
            "verified",
            "released",
            "blocked",
            "done"
          ],
          "type": "string"
        },
        "underlying_maturity": {
          "enum": [
            "planned",
            "in_progress",
            "ready_to_land",
            "merged",
            "verified",
            "released"
          ],
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "type": "string"
        },
        "accountable_owner": {
          "minLength": 1,
          "type": "string"
        },
        "criteria": {
          "$ref": "#/$defs/criteriaCoverage"
        },
        "delivery_surface": {
          "$ref": "#/$defs/deliverySurface"
        },
        "qualifying_stage_slots_filled": {
          "minimum": 0,
          "type": "integer"
        },
        "qualifying_stage_slots_required": {
          "minimum": 0,
          "type": "integer"
        },
        "qualifying_stage_unfilled_or_unknown_slot_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9._-]*$",
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "qualifying_stage_slots": {
          "items": {"$ref": "#/$defs/qualifyingStageSlot"},
          "type": "array",
          "uniqueItems": true
        },
        "source_watermark": {
          "minimum": 0,
          "type": "integer"
        },
        "projection_watermark": {
          "minimum": 0,
          "type": "integer"
        },
        "freshness": {
          "enum": [
            "fresh",
            "stale",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "confidence": {
          "enum": [
            "development_degraded",
            "disaster_safe",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "health": {
          "enum": [
            "CP3_D_NOT_PROVEN",
            "CURRENT",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "durability": {
          "enum": [
            "CP3_D_NOT_PROVEN",
            "CP3_D_PROVEN",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "recovery": {
          "enum": [
            "EXTERNAL_FAILURE_DOMAIN_UNPROVEN",
            "EXTERNAL_FAILURE_DOMAIN_PROVEN",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "data_class": {
          "enum": [
            "RECONSTRUCTIBLE_ONLY",
            "DISASTER_SAFE_CTOWER_ENGINEERING",
            "STATE_UNKNOWN"
          ],
          "type": "string"
        },
        "semantic_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "reconciled_at": {
          "format": "date-time",
          "type": "string"
        },
        "freshness_due_at": {
          "format": "date-time",
          "type": "string"
        },
        "rebuild_generation": {
          "minimum": 0,
          "type": "integer"
        },
        "source_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "derivation_reasons": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "checkpoint_key",
        "checkpoint_label",
        "headline_state",
        "underlying_maturity",
        "outcome",
        "accountable_owner",
        "criteria",
        "delivery_surface",
        "qualifying_stage_slots_filled",
        "qualifying_stage_slots_required",
        "qualifying_stage_unfilled_or_unknown_slot_keys",
        "qualifying_stage_slots",
        "source_watermark",
        "projection_watermark",
        "freshness",
        "confidence",
        "health",
        "durability",
        "recovery",
        "data_class",
        "semantic_digest",
        "reconciled_at",
        "freshness_due_at",
        "rebuild_generation",
        "source_ids",
        "derivation_reasons"
      ],
      "type": "object",
      "allOf": [
        {
          "$comment": "A stale or unknown projection cannot advertise current health.",
          "if": {
            "properties": {
              "freshness": {
                "enum": [
                  "stale",
                  "STATE_UNKNOWN"
                ]
              }
            },
            "required": [
              "freshness"
            ]
          },
          "then": {
            "properties": {
              "health": {
                "enum": [
                  "CP3_D_NOT_PROVEN",
                  "STATE_UNKNOWN"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "$id": "https://ctower.dev/contracts/domain/project-delivery/project-delivery.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ctower.project-delivery/v1"
    },
    "company_key": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "project_key": {
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "type": "string"
    },
    "source_record_position": {
      "minimum": 0,
      "type": "integer"
    },
    "projection_record_position": {
      "minimum": 0,
      "type": "integer"
    },
    "reconciled_at": {
      "format": "date-time",
      "type": "string"
    },
    "freshness_due_at": {
      "format": "date-time",
      "type": "string"
    },
    "projection_semantic_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "rebuild_generation": {
      "minimum": 0,
      "type": "integer"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/row"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "company_key",
    "project_key",
    "source_record_position",
    "projection_record_position",
    "reconciled_at",
    "freshness_due_at",
    "projection_semantic_digest",
    "rebuild_generation",
    "rows"
  ],
  "title": "compact read-only Project Delivery projection",
  "type": "object"
}
