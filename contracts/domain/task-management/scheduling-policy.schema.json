{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/domain/task-management/scheduling-policy.schema.json",
  "title": "SchedulingPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": ["aging", "hard_eligibility", "key", "preemption", "revision", "schema", "status", "tie_break"],
  "properties": {
    "schema": {"const": "ctower.scheduling-policy/v1"},
    "status": {"enum": ["draft", "staged", "active", "retired"]},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "hard_eligibility": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["capability", "trust", "readiness", "gates", "environment", "wip", "quota", "isolation"]
      }
    },
    "aging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_since_source", "maximum_boost_levels", "step_seconds"],
      "properties": {
        "eligible_since_source": {"const": "first_continuous_eligibility"},
        "maximum_boost_levels": {"type": "integer", "minimum": 1, "maximum": 2},
        "step_seconds": {"type": "integer", "minimum": 60}
      }
    },
    "preemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_only_if"],
      "properties": {"allowed_only_if": {"const": "checkpoint_verified"}}
    },
    "tie_break": {
      "type": "array",
      "prefixItems": [{"const": "eligible_since"}, {"const": "ticket_id"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  }
}
