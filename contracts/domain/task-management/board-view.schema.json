{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/domain/task-management/board-view.schema.json",
  "title": "BoardView",
  "type": "object",
  "additionalProperties": false,
  "required": ["cards", "health", "projection_watermark", "source_watermark"],
  "properties": {
    "cards": {"type": "array", "items": {"$ref": "#/$defs/card"}},
    "health": {"$ref": "#/$defs/health"},
    "projection_watermark": {"type": "integer", "minimum": 0},
    "source_watermark": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "lane": {
      "type": "string",
      "enum": ["backlog", "ready", "in_progress", "in_review", "blocked", "complete"]
    },
    "health": {"type": "string", "enum": ["CURRENT", "STATE_UNKNOWN"]},
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_class", "assignee_id", "blocker_opened_at", "blocker_reason",
        "custodian_id", "delivery_facts", "lane", "priority", "risk", "stage_key",
        "stage_label", "ticket_id", "title", "underlying_lane", "version"
      ],
      "properties": {
        "activity_class": {"type": ["string", "null"], "enum": ["work", "verification", null]},
        "assignee_id": {"type": ["string", "null"], "format": "uuid"},
        "blocker_opened_at": {"type": ["string", "null"], "format": "date-time"},
        "blocker_reason": {"type": ["string", "null"]},
        "custodian_id": {"type": "string", "format": "uuid"},
        "delivery_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["change_merged", "staging_verified", "production_verified", "rolled_back", "incident_open"]
          },
          "uniqueItems": true
        },
        "lane": {"$ref": "#/$defs/lane"},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
        "risk": {"type": ["string", "null"], "maxLength": 64},
        "stage_key": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9._-]*$"},
        "stage_label": {"type": ["string", "null"], "maxLength": 120},
        "ticket_id": {"type": "string", "format": "uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "underlying_lane": {"oneOf": [{"$ref": "#/$defs/lane"}, {"type": "null"}]},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignee_id": {"type": "string", "format": "uuid"},
        "custodian_id": {"type": "string", "format": "uuid"},
        "lane": {"$ref": "#/$defs/lane"},
        "priority": {"type": "string", "enum": ["P0", "P1", "P2"]},
        "risk": {"type": "string", "maxLength": 64},
        "stage_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}
      }
    }
  }
}
