{
  "$id": "https://ctower.dev/contracts/domain/migration/estate-import-parity.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Estate import parity report",
  "description": "One typed parity report per import tier, emitted before any source-path closure act. Names source row count, imported record count, per-batch digests, and sampled content hashes; unknown source owners appear under an explicit source-only state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tier",
    "manifest_digest",
    "source_count",
    "imported_count",
    "batches",
    "sampled_content_hashes",
    "source_only_owners",
    "emitted_before_closure",
    "parity_digest",
    "signature"
  ],
  "properties": {
    "schema": { "const": "ctower.estate-import-parity/v1" },
    "tier": {
      "enum": ["inbox_history", "agreed_decisions", "knowledge_documents", "company_records"]
    },
    "manifest_digest": { "$ref": "#/$defs/sha256" },
    "source_count": { "type": "integer", "minimum": 0 },
    "imported_count": { "type": "integer", "minimum": 0 },
    "batches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch_index", "batch_digest", "source_count", "imported_count"],
        "properties": {
          "batch_index": { "type": "integer", "minimum": 0 },
          "batch_digest": { "$ref": "#/$defs/sha256" },
          "source_count": { "type": "integer", "minimum": 0 },
          "imported_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "sampled_content_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_ref", "content_sha256"],
        "properties": {
          "source_ref": { "type": "string", "minLength": 1, "maxLength": 512 },
          "content_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "source_only_owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_seat", "row_count", "source_only_disposition"],
        "properties": {
          "source_seat": { "type": "string", "minLength": 1, "maxLength": 128 },
          "row_count": { "type": "integer", "minimum": 1 },
          "source_only_disposition": { "const": "source_only" }
        }
      }
    },
    "emitted_before_closure": { "const": true },
    "parity_digest": { "$ref": "#/$defs/sha256" },
    "signature": { "$ref": "#/$defs/ed25519-signature" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ed25519-signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "signed_digest",
        "key_ref",
        "key_version",
        "public_key_digest",
        "signature"
      ],
      "properties": {
        "algorithm": { "const": "Ed25519" },
        "signed_digest": { "$ref": "#/$defs/sha256" },
        "key_ref": { "type": "string", "pattern": "^signing-key-ref:[a-z0-9/_-]{1,96}$" },
        "key_version": { "type": "integer", "minimum": 1 },
        "public_key_digest": { "$ref": "#/$defs/sha256" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
