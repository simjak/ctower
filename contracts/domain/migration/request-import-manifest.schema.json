{
  "$id": "https://ctower.dev/contracts/domain/migration/request-import-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed exact Mission Control open-Request denominator",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "archive_ref",
    "batch_size",
    "counts",
    "fence_digest",
    "ledger_sha256",
    "maximum_request_number",
    "open_request_ids",
    "owner_mapping_sha256",
    "rows_digest",
    "rows",
    "sampling_seed",
    "batches",
    "source_identity",
    "target_authority_digest",
    "target_tenant_id",
    "manifest_digest",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ctower.request-import-manifest/v1"},
    "archive_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "batch_size": {"const": 25},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_rows", "logical_requests", "open_requests", "open_by_project"],
      "properties": {
        "physical_rows": {"type": "integer", "minimum": 0},
        "logical_requests": {"type": "integer", "minimum": 0},
        "open_requests": {"type": "integer", "minimum": 0},
        "open_by_project": {"$ref": "#/$defs/projectCounts"}
      }
    },
    "fence_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "ledger_sha256": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "maximum_request_number": {"type": "integer", "minimum": 0},
    "open_request_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^R[1-9][0-9]*$"}
    },
    "owner_mapping_sha256": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "rows_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "rows": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/row"}
    },
    "sampling_seed": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "batches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_index",
          "batch_digest",
          "source_count",
          "source_count_by_project",
          "cumulative_count",
          "sample_ids"
        ],
        "properties": {
          "batch_index": {"type": "integer", "minimum": 0},
          "batch_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
          "source_count": {"type": "integer", "minimum": 1, "maximum": 25},
          "source_count_by_project": {"$ref": "#/$defs/projectCounts"},
          "cumulative_count": {"type": "integer", "minimum": 1},
          "sample_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^R[1-9][0-9]*$"}
          }
        }
      }
    },
    "source_identity": {"$ref": "request-source-fence.schema.json#/$defs/sourceIdentity"},
    "target_authority_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "target_tenant_id": {"type": "string", "format": "uuid"},
    "manifest_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "signature": {"$ref": "migration-boundary.schema.json#/$defs/detachedSignature"}
  },
  "$defs": {
    "projectCounts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/projectCount"}
    },
    "projectCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_key", "count"],
      "properties": {
        "project_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "count": {"type": "integer", "minimum": 1}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "request_number",
        "request_id",
        "command_id",
        "content_sha256",
        "created_at",
        "latest_line",
        "latest_row_sha256",
        "mapped_principal_id",
        "original_owner_sha256",
        "priority",
        "project_key",
        "projection",
        "refines",
        "relationships_sha256",
        "source_owner",
        "source_status",
        "updated_at"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
        "request_number": {"type": "integer", "minimum": 1},
        "request_id": {"type": "string", "format": "uuid"},
        "command_id": {"type": "string", "format": "uuid"},
        "content_sha256": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
        "created_at": {"type": "string", "format": "date-time"},
        "latest_line": {"type": "integer", "minimum": 1},
        "latest_row_sha256": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
        "mapped_principal_id": {"type": "string", "format": "uuid"},
        "original_owner_sha256": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "project_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocker", "priority", "state", "triage"],
          "properties": {
            "blocker": {"type": "boolean"},
            "priority": {"enum": ["P0", "P1", "P2"]},
            "state": {"enum": ["NEW", "TRIAGED"]},
            "triage": {"enum": ["UNTRIAGED", "ACCEPTED"]}
          }
        },
        "refines": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^R[1-9][0-9]*$"}
        },
        "relationships_sha256": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
        "source_owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "source_status": {"enum": ["NEW", "TRIAGED", "WIP", "BLOCKED"]},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
