{
  "$id": "https://ctower.dev/contracts/domain/migration/ctower-project-import-batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Restricted 64-item ctower-project import batch",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "cutover_id",
    "batch_index",
    "batch_digest",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": "ctower.ctower-project-import-batch/v1"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "cutover_id": {
      "type": "string",
      "format": "uuid"
    },
    "batch_index": {
      "type": "integer",
      "minimum": 0
    },
    "batch_digest": {
      "$ref": "migration-boundary.schema.json#/$defs/digest"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/ticketSeed"
          },
          {
            "$ref": "#/$defs/exactAlias"
          },
          {
            "$ref": "#/$defs/ticketRelation"
          },
          {
            "$ref": "#/$defs/sourceLink"
          }
        ]
      }
    }
  },
  "$defs": {
    "operationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "immutable_source_id",
        "source_version_or_digest",
        "operation_kind",
        "planned_target_ref",
        "command_id"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "immutable_source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "source_version_or_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operation_kind": {
          "type": "string",
          "enum": [
            "ticket_seed",
            "exact_alias",
            "ticket_relation",
            "source_link"
          ]
        },
        "planned_target_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "command_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ticketSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "identity",
        "project_key",
        "priority",
        "title",
        "source",
        "initial_commander_custodian_id"
      ],
      "properties": {
        "operation": {
          "const": "ticket_seed"
        },
        "identity": {
          "$ref": "#/$defs/operationIdentity"
        },
        "project_key": {
          "const": "ctower"
        },
        "priority": {
          "const": "P2"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "source": {
          "$ref": "migration-boundary.schema.json#/$defs/sourceIdentity"
        },
        "initial_commander_custodian_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "exactAlias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "identity",
        "project_key",
        "source",
        "target_ticket_id"
      ],
      "properties": {
        "operation": {
          "const": "exact_alias"
        },
        "identity": {
          "$ref": "#/$defs/operationIdentity"
        },
        "project_key": {
          "const": "ctower"
        },
        "source": {
          "$ref": "migration-boundary.schema.json#/$defs/sourceIdentity"
        },
        "target_ticket_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "ticketRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "identity",
        "project_key",
        "relation_id",
        "relation_kind",
        "source_ticket_id",
        "target_ticket_id",
        "reason"
      ],
      "properties": {
        "operation": {
          "const": "ticket_relation"
        },
        "identity": {
          "$ref": "#/$defs/operationIdentity"
        },
        "project_key": {
          "const": "ctower"
        },
        "relation_id": {
          "type": "string",
          "format": "uuid"
        },
        "relation_kind": {
          "type": "string",
          "enum": [
            "parent_of",
            "depends_on",
            "blocks",
            "duplicates",
            "relates_to",
            "caused_by"
          ]
        },
        "source_ticket_id": {
          "type": "string",
          "format": "uuid"
        },
        "target_ticket_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "sourceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "identity",
        "project_key",
        "source",
        "link_class",
        "target_kind",
        "target_id",
        "reason_code",
        "linked_not_proof"
      ],
      "properties": {
        "operation": {
          "const": "source_link"
        },
        "identity": {
          "$ref": "#/$defs/operationIdentity"
        },
        "project_key": {
          "const": "ctower"
        },
        "source": {
          "$ref": "migration-boundary.schema.json#/$defs/sourceIdentity"
        },
        "link_class": {
          "type": "string",
          "enum": [
            "decision",
            "external_effect",
            "artifact_not_proof",
            "provenance"
          ]
        },
        "target_kind": {
          "type": "string",
          "enum": [
            "ticket",
            "ticket_relation",
            "checkpoint",
            "decision",
            "artifact",
            "external_effect"
          ]
        },
        "target_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,95}$"
        },
        "linked_not_proof": {
          "const": true
        }
      }
    }
  }
}
