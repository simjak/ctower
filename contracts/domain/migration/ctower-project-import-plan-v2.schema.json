{
  "$id": "https://ctower.dev/contracts/domain/migration/ctower-project-import-plan-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed exhaustive ctower-project import plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "run_id",
    "cutover_id",
    "selection_digest",
    "export_equality_digest",
    "alias_map_digest",
    "created_at",
    "batch_count",
    "operation_count",
    "batches",
    "checkpoint_definitions",
    "source_native_watermark",
    "export_native_watermark",
    "review",
    "plan_digest",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ctower.ctower-project-import-plan/v2"},
    "plan_id": {"type": "string", "format": "uuid"},
    "run_id": {"type": "string", "format": "uuid"},
    "cutover_id": {"type": "string", "format": "uuid"},
    "selection_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "export_equality_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "alias_map_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "batch_count": {"type": "integer", "minimum": 1},
    "operation_count": {"type": "integer", "minimum": 1},
    "batches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "ctower-project-import-batch.schema.json"}
    },
    "checkpoint_definitions": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkpoint_key",
          "catalog_revision",
          "definition_digest",
          "criteria_digest"
        ],
        "properties": {
          "checkpoint_key": {"type": "string", "pattern": "^I[12]\\.[0-9]+$"},
          "catalog_revision": {"type": "string", "minLength": 1, "maxLength": 256},
          "definition_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
          "criteria_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"}
        }
      }
    },
    "source_native_watermark": {"type": "integer", "minimum": 0},
    "export_native_watermark": {"type": "integer", "minimum": 0},
    "review": {"$ref": "migration-boundary.schema.json#/$defs/review"},
    "plan_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "signature": {"$ref": "migration-boundary.schema.json#/$defs/detachedSignature"}
  }
}
