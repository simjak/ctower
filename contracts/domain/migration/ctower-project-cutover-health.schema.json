{
  "$id": "https://ctower.dev/contracts/domain/migration/ctower-project-cutover-health.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ctower.ctower-project-cutover-health/v1"
    },
    "cutover_id": {
      "oneOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority_mode": {
      "enum": [
        "legacy_writable",
        "development_single_writer",
        "disaster_safe"
      ],
      "type": "string"
    },
    "phase": {
      "enum": [
        "not_started",
        "source_selection_frozen",
        "export_equal",
        "alias_plan_bound",
        "import_in_progress",
        "reconciled",
        "prepared",
        "development_epoch_committed",
        "disaster_safe_active"
      ],
      "type": "string"
    },
    "writes_enabled": {
      "type": "boolean"
    },
    "durability_claim": {
      "enum": [
        "CP3_D_NOT_PROVEN",
        "CP3_D_PROVEN"
      ],
      "type": "string"
    },
    "recovery_claim": {
      "enum": [
        "EXTERNAL_FAILURE_DOMAIN_UNPROVEN",
        "EXTERNAL_FAILURE_DOMAIN_PROVEN"
      ],
      "type": "string"
    },
    "data_class": {
      "enum": [
        "RECONSTRUCTIBLE_ONLY",
        "DISASTER_SAFE_CTOWER_ENGINEERING"
      ],
      "type": "string"
    },
    "legacy_writer_fence": {
      "enum": [
        "not_armed",
        "enforced",
        "unknown"
      ],
      "type": "string"
    },
    "split_brain": {
      "enum": [
        "clear",
        "detected",
        "unknown"
      ],
      "type": "string"
    },
    "projection_completeness": {
      "enum": [
        "current",
        "stale",
        "STATE_UNKNOWN"
      ],
      "type": "string"
    },
    "source_watermark": {
      "minimum": 0,
      "type": "integer"
    },
    "projection_watermark": {
      "minimum": 0,
      "type": "integer"
    },
    "import_run_id": {
      "oneOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "migration_digests": {
      "additionalProperties": false,
      "properties": {
        "source_selection": {
          "oneOf": [
            {
              "$ref": "migration-boundary.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "export_equality": {
          "oneOf": [
            {
              "$ref": "migration-boundary.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "alias_map": {
          "oneOf": [
            {
              "$ref": "migration-boundary.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "reconciliation": {
          "oneOf": [
            {
              "$ref": "migration-boundary.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "fence_registry": {
          "oneOf": [
            {
              "$ref": "migration-boundary.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "fence_observation": {
          "oneOf": [
            {
              "$ref": "migration-boundary.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_selection",
        "export_equality",
        "alias_map",
        "reconciliation",
        "fence_registry",
        "fence_observation"
      ],
      "type": "object"
    },
    "banner": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "cutover_id",
    "authority_mode",
    "phase",
    "writes_enabled",
    "durability_claim",
    "recovery_claim",
    "data_class",
    "legacy_writer_fence",
    "split_brain",
    "projection_completeness",
    "source_watermark",
    "projection_watermark",
    "import_run_id",
    "migration_digests",
    "banner"
  ],
  "title": "ctower-project cutover health",
  "type": "object",
  "allOf": [
    {
      "$comment": "Every pre-epoch I1.7B phase remains legacy_writable. prepared is an I1.7C-only state.",
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "not_started",
              "source_selection_frozen",
              "export_equal",
              "alias_plan_bound",
              "import_in_progress",
              "reconciled",
              "prepared"
            ]
          }
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "authority_mode": {"const": "legacy_writable"}
        },
        "required": ["authority_mode"]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {"const": "development_epoch_committed"}
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "authority_mode": {"const": "development_single_writer"}
        },
        "required": ["authority_mode"]
      }
    },
    {
      "if": {
        "properties": {
          "phase": {"const": "disaster_safe_active"}
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "authority_mode": {"const": "disaster_safe"}
        },
        "required": ["authority_mode"]
      }
    },
    {
      "$comment": "disaster_safe authority requires proven CP3-D, proven external failure-domain recovery, and disaster-safe data class; every non-disaster mode requires the unproven/reconstructible set.",
      "if": {
        "properties": {
          "authority_mode": {"const": "disaster_safe"}
        },
        "required": ["authority_mode"]
      },
      "then": {
        "properties": {
          "durability_claim": {"const": "CP3_D_PROVEN"},
          "recovery_claim": {"const": "EXTERNAL_FAILURE_DOMAIN_PROVEN"},
          "data_class": {"const": "DISASTER_SAFE_CTOWER_ENGINEERING"}
        },
        "required": ["durability_claim", "recovery_claim", "data_class"]
      }
    },
    {
      "if": {
        "properties": {
          "authority_mode": {"enum": ["legacy_writable", "development_single_writer"]}
        },
        "required": ["authority_mode"]
      },
      "then": {
        "properties": {
          "durability_claim": {"const": "CP3_D_NOT_PROVEN"},
          "recovery_claim": {"const": "EXTERNAL_FAILURE_DOMAIN_UNPROVEN"},
          "data_class": {"const": "RECONSTRUCTIBLE_ONLY"}
        },
        "required": ["durability_claim", "recovery_claim", "data_class"]
      }
    },
    {
      "$comment": "writes_enabled requires an enforced fence, a clear split-brain, and a non-legacy authority mode (migration 0027 writes_enabled CHECK).",
      "if": {
        "properties": {
          "writes_enabled": {"const": true}
        },
        "required": ["writes_enabled"]
      },
      "then": {
        "properties": {
          "legacy_writer_fence": {"const": "enforced"},
          "split_brain": {"const": "clear"},
          "authority_mode": {"enum": ["development_single_writer", "disaster_safe"]}
        },
        "required": ["legacy_writer_fence", "split_brain", "authority_mode"]
      }
    },
    {
      "$comment": "A fence finding can only degrade health and must disable writes.",
      "if": {
        "properties": {
          "split_brain": {
            "enum": [
              "detected",
              "unknown"
            ]
          }
        },
        "required": ["split_brain"]
      },
      "then": {
        "properties": {
          "writes_enabled": {"const": false},
          "projection_completeness": {"const": "STATE_UNKNOWN"}
        },
        "required": ["writes_enabled", "projection_completeness"]
      }
    },
    {
      "$comment": "No pre-epoch migration phase may advertise ctower writes.",
      "if": {
        "properties": {
          "phase": {
            "enum": [
              "not_started",
              "source_selection_frozen",
              "export_equal",
              "alias_plan_bound",
              "import_in_progress",
              "reconciled",
              "prepared"
            ]
          }
        },
        "required": ["phase"]
      },
      "then": {
        "properties": {
          "writes_enabled": {"const": false}
        },
        "required": ["writes_enabled"]
      }
    }
  ]
}
