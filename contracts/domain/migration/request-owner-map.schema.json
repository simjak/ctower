{
  "$id": "https://ctower.dev/contracts/domain/migration/request-owner-map.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Request owner and priority mapping",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target_tenant_id",
    "target_authority_digest",
    "reviewed_at",
    "reviewed_by",
    "mappings",
    "request_reviews"
  ],
  "properties": {
    "schema": {"const": "ctower.request-owner-map/v1"},
    "target_tenant_id": {"type": "string", "format": "uuid"},
    "target_authority_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 256},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_key", "source_owner", "principal_id"],
        "properties": {
          "project_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
          "source_owner": {"type": "string", "minLength": 1, "maxLength": 256},
          "principal_id": {"type": "string", "format": "uuid"}
        }
      }
    },
    "request_reviews": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^R[1-9][0-9]*$"},
          "priority": {"enum": ["P0", "P1", "P2"]}
        }
      }
    }
  }
}
