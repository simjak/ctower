{
  "$id": "https://ctower.dev/contracts/domain/migration/ctower-project-phase.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ctower.ctower-project-migration-phase/v1"
    },
    "cutover_id": {
      "format": "uuid",
      "type": "string"
    },
    "phase": {
      "enum": [
        "inventory",
        "export",
        "plan",
        "import",
        "reconcile",
        "prepare",
        "commit_development_epoch"
      ],
      "type": "string"
    },
    "input_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "cutover_id",
    "phase",
    "input_digest"
  ],
  "title": "ctower-project online migration phase stub",
  "type": "object"
}
