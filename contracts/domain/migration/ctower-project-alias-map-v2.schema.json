{
  "$id": "https://ctower.dev/contracts/domain/migration/ctower-project-alias-map-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed exact alias, stable-ticket, and disposition map v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "alias_map_id",
    "cutover_id",
    "selection_digest",
    "export_equality_digest",
    "created_at",
    "stable_aliases",
    "entries",
    "attention_required",
    "map_digest",
    "review",
    "signature"
  ],
  "properties": {
    "schema": {"const": "ctower.ctower-project-alias-map/v2"},
    "alias_map_id": {"type": "string", "format": "uuid"},
    "cutover_id": {"type": "string", "format": "uuid"},
    "selection_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "export_equality_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "created_at": {"type": "string", "format": "date-time"},
    "stable_aliases": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_item_id", "target_ticket_id"],
        "properties": {
          "stable_item_id": {
            "type": "string",
            "pattern": "^CT-(?:L0|I1|I2)-[0-9]{3}$"
          },
          "target_ticket_id": {"type": "string", "format": "uuid"}
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "disposition", "planned_target_ref", "reason_code"],
        "properties": {
          "identity": {"$ref": "migration-boundary.schema.json#/$defs/sourceIdentity"},
          "disposition": {
            "enum": [
              "created_ticket",
              "alias_linked_existing",
              "project_checkpoint_definition",
              "decision_link",
              "external_effect_link",
              "artifact_linked_not_proof",
              "provenance_only",
              "exact_duplicate",
              "excluded_out_of_scope",
              "attention_required"
            ]
          },
          "planned_target_ref": {
            "oneOf": [
              {"const": "new_ticket"},
              {
                "type": "string",
                "pattern": "^(?:ticket|checkpoint|decision|artifact|external-effect):[A-Za-z0-9._:-]{1,240}$"
              },
              {"type": "null"}
            ]
          },
          "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,95}$"}
        }
      }
    },
    "attention_required": {"const": 0},
    "map_digest": {"$ref": "migration-boundary.schema.json#/$defs/digest"},
    "review": {"$ref": "migration-boundary.schema.json#/$defs/review"},
    "signature": {"$ref": "migration-boundary.schema.json#/$defs/detachedSignature"}
  }
}
