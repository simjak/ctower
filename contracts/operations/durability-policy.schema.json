{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/operations/durability-policy.schema.json",
  "title": "Durability policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "policy_ref",
    "mode",
    "synchronous_commit",
    "standby_count",
    "standby_application_name",
    "standby_identity",
    "commit_deadline_ms",
    "retry_after_seconds"
  ],
  "properties": {
    "schema_id": {"const": "ctower.durability-policy/v1"},
    "policy_ref": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*@[1-9][0-9]*$"},
    "mode": {"type": "string", "enum": ["pending_only", "cutover_rpo0"]},
    "synchronous_commit": {"const": "remote_apply"},
    "standby_count": {"const": 1},
    "standby_application_name": {"const": "ctower_i1_ack"},
    "standby_identity": {"type": "string", "minLength": 1, "maxLength": 128},
    "commit_deadline_ms": {"type": "integer", "minimum": 100, "maximum": 30000},
    "retry_after_seconds": {"type": "integer", "minimum": 1, "maximum": 60}
  }
}
