{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.dev/contracts/operations/private-vps-evidence.schema.json",
  "title": "Development-only private-VPS recurrence evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "claim",
    "assurance",
    "durability_policy",
    "object_adapter",
    "key_adapter",
    "provenance",
    "schedule_ref",
    "calendar",
    "window_start",
    "window_end",
    "deployment_manifest_artifact_id",
    "bound_inputs",
    "artifacts",
    "occurrences"
  ],
  "properties": {
    "schema": {"const": "ctower.private-vps-evidence/v1"},
    "evidence_id": {"$ref": "#/$defs/identifier"},
    "claim": {"const": "development_rehearsal"},
    "assurance": {"const": "development"},
    "durability_policy": {"const": "pending_only"},
    "object_adapter": {"const": "local_encrypted_filesystem"},
    "key_adapter": {"const": "local_file"},
    "provenance": {"const": "self_declared_development_reference"},
    "schedule_ref": {"$ref": "#/$defs/reference"},
    "calendar": {"const": "weekday_mon_fri_utc"},
    "window_start": {"type": "string", "format": "date"},
    "window_end": {"type": "string", "format": "date"},
    "deployment_manifest_artifact_id": {"$ref": "#/$defs/identifier"},
    "bound_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "control_image", "configuration"],
      "properties": {
        "source": {"$ref": "#/$defs/source"},
        "control_image": {"$ref": "#/$defs/image"},
        "configuration": {"$ref": "#/$defs/configuration"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 20,
      "maxItems": 50,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "occurrences": {
      "type": "array",
      "minItems": 5,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/occurrence"}
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitObject": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{2,127}$"},
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9][A-Za-z0-9._/:/-]*@sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^(alert-owner|credential-file|file|identity|object-root|schedule|telemetry)-ref://[A-Za-z0-9._~:/-]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha", "tree"],
      "properties": {
        "sha": {"$ref": "#/$defs/gitObject"},
        "tree": {"$ref": "#/$defs/gitObject"}
      }
    },
    "configArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compose", "caddyfile", "otel_collector"],
      "properties": {
        "compose": {"$ref": "#/$defs/configArtifact"},
        "caddyfile": {"$ref": "#/$defs/configArtifact"},
        "otel_collector": {"$ref": "#/$defs/configArtifact"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "path", "sha256", "media_type", "content_schema"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "deployment_preflight",
            "tls_access",
            "database_bootstrap",
            "health_telemetry",
            "upgrade_rollback",
            "worker_restart",
            "host_reboot",
            "restore_report",
            "clean_install",
            "legacy_baseline",
            "synthetic_occurrence",
            "scheduler_receipt"
          ]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "media_type": {"const": "application/json"},
        "content_schema": {
          "enum": [
            "ctower.private-vps-deployment/v1",
            "ctower.private-vps-check/v1",
            "ctower.private-vps-synthetic-result/v1",
            "ctower.private-vps-scheduler-receipt/v1"
          ]
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence_id",
        "schedule_ref",
        "scheduled_for",
        "working_day",
        "trigger",
        "origin",
        "result_artifact_id",
        "scheduler_receipt_artifact_id",
        "manual_command_ref"
      ],
      "properties": {
        "occurrence_id": {"$ref": "#/$defs/identifier"},
        "schedule_ref": {"$ref": "#/$defs/reference"},
        "scheduled_for": {"type": "string", "format": "date-time"},
        "working_day": {"type": "string", "format": "date"},
        "trigger": {"const": "scheduled"},
        "origin": {"const": "routine_scheduler_reference"},
        "result_artifact_id": {"$ref": "#/$defs/identifier"},
        "scheduler_receipt_artifact_id": {"$ref": "#/$defs/identifier"},
        "manual_command_ref": {"type": "null"}
      }
    },
    "checkArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "artifact_id",
        "kind",
        "outcome",
        "provenance",
        "observed_at",
        "source",
        "control_image"
      ],
      "properties": {
        "schema": {"const": "ctower.private-vps-check/v1"},
        "artifact_id": {"$ref": "#/$defs/identifier"},
        "kind": {
          "enum": [
            "tls_access",
            "database_bootstrap",
            "health_telemetry",
            "upgrade_rollback",
            "worker_restart",
            "host_reboot",
            "restore_report",
            "clean_install",
            "legacy_baseline"
          ]
        },
        "outcome": {"const": "pass"},
        "provenance": {"const": "self_declared_development_reference"},
        "observed_at": {"type": "string", "format": "date-time"},
        "source": {"$ref": "#/$defs/source"},
        "control_image": {"$ref": "#/$defs/image"}
      }
    },
    "syntheticResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "occurrence_id",
        "schedule_ref",
        "scheduled_for",
        "working_day",
        "outcome",
        "provenance",
        "source",
        "control_image"
      ],
      "properties": {
        "schema": {"const": "ctower.private-vps-synthetic-result/v1"},
        "occurrence_id": {"$ref": "#/$defs/identifier"},
        "schedule_ref": {"$ref": "#/$defs/reference"},
        "scheduled_for": {"type": "string", "format": "date-time"},
        "working_day": {"type": "string", "format": "date"},
        "outcome": {"const": "pass"},
        "provenance": {"const": "self_declared_development_reference"},
        "source": {"$ref": "#/$defs/source"},
        "control_image": {"$ref": "#/$defs/image"}
      }
    },
    "schedulerReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "occurrence_id",
        "schedule_ref",
        "scheduled_for",
        "working_day",
        "trigger",
        "origin",
        "provenance",
        "source",
        "control_image",
        "manual_command_ref"
      ],
      "properties": {
        "schema": {"const": "ctower.private-vps-scheduler-receipt/v1"},
        "occurrence_id": {"$ref": "#/$defs/identifier"},
        "schedule_ref": {"$ref": "#/$defs/reference"},
        "scheduled_for": {"type": "string", "format": "date-time"},
        "working_day": {"type": "string", "format": "date"},
        "trigger": {"const": "scheduled"},
        "origin": {"const": "routine_scheduler_reference"},
        "provenance": {"const": "self_declared_development_reference"},
        "source": {"$ref": "#/$defs/source"},
        "control_image": {"$ref": "#/$defs/image"},
        "manual_command_ref": {"type": "null"}
      }
    }
  }
}
