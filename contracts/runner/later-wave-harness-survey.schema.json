{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/runner/later-wave-harness-survey.schema.json",
  "title": "LaterWaveHarnessSurvey",
  "description": "Revision-pinned CT-I1-044 survey data. Unknown evidence is explicit and cannot be used to choose a configure/provide role.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "observed_at", "sources", "questions", "candidates"],
  "properties": {
    "schema": { "const": "ctower.later-wave-harness-survey/v1" },
    "revision": { "const": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" },
      "allOf": [
        { "contains": { "required": ["id"], "properties": { "id": { "const": "spec-ct-i1-044" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "design-seam-c07" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "auth-runbook-2026-08-17" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "hermes-binding-d724" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "claude-binding-d724" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "codex-candidate-ee197" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "qwen-cli-0215" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "qwen-docs-0215" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "local-command-absence" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "ctower-weight-registry-d724" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/question" },
      "allOf": [
        { "contains": { "required": ["id"], "properties": { "id": { "const": "native_pool" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "native_fallback" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "config_surface" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "identity_proof" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "reset_window_semantics" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "rotation_cache_semantics" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "subagent_credential_inheritance" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "egress_topology" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "probe_target" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["id"], "properties": { "id": { "const": "credit_weights" } } }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/candidate" },
      "allOf": [
        { "contains": { "required": ["key"], "properties": { "key": { "const": "openclaw" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["key"], "properties": { "key": { "const": "qwen-code" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["key"], "properties": { "key": { "const": "zcode" } } }, "minContains": 1, "maxContains": 1 },
        { "contains": { "required": ["key"], "properties": { "key": { "const": "deepseek" } } }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "source-id": {
      "enum": [
        "spec-ct-i1-044",
        "design-seam-c07",
        "auth-runbook-2026-08-17",
        "hermes-binding-d724",
        "claude-binding-d724",
        "codex-candidate-ee197",
        "qwen-cli-0215",
        "qwen-docs-0215",
        "local-command-absence",
        "ctower-weight-registry-d724"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "revision", "locator"],
      "properties": {
        "id": {
          "$ref": "#/$defs/source-id"
        },
        "kind": {
          "enum": ["repo", "design", "runbook", "binary", "installed-doc", "absence-probe"]
        },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": {
          "enum": [
            "native_pool",
            "native_fallback",
            "config_surface",
            "identity_proof",
            "reset_window_semantics",
            "rotation_cache_semantics",
            "subagent_credential_inheritance",
            "egress_topology",
            "probe_target",
            "credit_weights"
          ]
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "evidence", "note"],
      "properties": {
        "state": { "enum": ["verified", "not_applicable", "unverified"] },
        "value": { "type": ["boolean", "string", "null"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source-id" }
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "unverified" } }
          },
          "then": { "properties": { "value": { "type": "null" } } }
        },
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "enum": ["verified", "not_applicable"] } }
          },
          "then": { "properties": { "value": { "type": ["boolean", "string"] } } }
        }
      ]
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["refused", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "capability_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "evidence", "reason"],
      "properties": {
        "liveness": {
          "type": "string",
          "pattern": "^(unknown|inherited:[a-z][a-z0-9_.-]{2,127})$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source-id" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "classification",
        "effective_route",
        "adapter_work",
        "role_disposition",
        "registration",
        "capability_declaration",
        "answers"
      ],
      "properties": {
        "key": { "enum": ["openclaw", "qwen-code", "zcode", "deepseek"] },
        "classification": {
          "enum": ["harness_gateway_routed", "harness_baseline", "harness_stub", "model"]
        },
        "effective_route": {
          "enum": ["gateway", "qwen-cli", "unbound-stub", "hermes-profile"]
        },
        "adapter_work": { "enum": ["blocked_until_survey", "zero"] },
        "role_disposition": { "enum": ["undecidable", "not_applicable"] },
        "registration": { "$ref": "#/$defs/registration" },
        "capability_declaration": { "$ref": "#/$defs/capability_declaration" },
        "answers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native_pool",
            "native_fallback",
            "config_surface",
            "identity_proof",
            "reset_window_semantics",
            "rotation_cache_semantics",
            "subagent_credential_inheritance",
            "egress_topology",
            "probe_target",
            "credit_weights"
          ],
          "properties": {
            "native_pool": { "$ref": "#/$defs/answer" },
            "native_fallback": { "$ref": "#/$defs/answer" },
            "config_surface": { "$ref": "#/$defs/answer" },
            "identity_proof": { "$ref": "#/$defs/answer" },
            "reset_window_semantics": { "$ref": "#/$defs/answer" },
            "rotation_cache_semantics": { "$ref": "#/$defs/answer" },
            "subagent_credential_inheritance": { "$ref": "#/$defs/answer" },
            "egress_topology": { "$ref": "#/$defs/answer" },
            "probe_target": { "$ref": "#/$defs/answer" },
            "credit_weights": { "$ref": "#/$defs/answer" }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "openclaw" } } },
          "then": {
            "properties": {
              "classification": { "const": "harness_gateway_routed" },
              "effective_route": { "const": "gateway" },
              "adapter_work": { "const": "blocked_until_survey" },
              "role_disposition": { "const": "undecidable" },
              "registration": { "properties": { "status": { "const": "refused" } } },
              "capability_declaration": { "properties": { "liveness": { "const": "unknown" } } }
            }
          }
        },
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "qwen-code" } } },
          "then": {
            "properties": {
              "classification": { "const": "harness_baseline" },
              "effective_route": { "const": "qwen-cli" },
              "adapter_work": { "const": "blocked_until_survey" },
              "role_disposition": { "const": "undecidable" },
              "registration": { "properties": { "status": { "const": "refused" } } },
              "capability_declaration": { "properties": { "liveness": { "const": "unknown" } } }
            }
          }
        },
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "zcode" } } },
          "then": {
            "properties": {
              "classification": { "const": "harness_stub" },
              "effective_route": { "const": "unbound-stub" },
              "adapter_work": { "const": "blocked_until_survey" },
              "role_disposition": { "const": "undecidable" },
              "registration": { "properties": { "status": { "const": "refused" } } },
              "capability_declaration": { "properties": { "liveness": { "const": "unknown" } } }
            }
          }
        },
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "deepseek" } } },
          "then": {
            "properties": {
              "classification": { "const": "model" },
              "effective_route": { "const": "hermes-profile" },
              "adapter_work": { "const": "zero" },
              "role_disposition": { "const": "not_applicable" },
              "registration": { "properties": { "status": { "const": "not_applicable" } } },
              "capability_declaration": { "properties": { "liveness": { "const": "inherited:hermes.gateway_log" } } }
            }
          }
        }
      ]
    }
  }
}
