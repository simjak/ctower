{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/runner/later-wave-harness-survey.schema.json",
  "title": "LaterWaveHarnessSurvey",
  "description": "Revision-pinned CT-I1-044 survey data. Unknown evidence is explicit and cannot be used to choose a configure/provide role.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "observed_at", "sources", "questions", "candidates"],
  "properties": {
    "schema": { "const": "ctower.later-wave-harness-survey/v1" },
    "revision": { "const": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "const": [
        {
          "id": "spec-ct-i1-044",
          "kind": "repo",
          "revision": "d72408e7",
          "locator": "docs/internal/SPEC.md:5342 (CT-I1-044)"
        },
        {
          "id": "design-seam-c07",
          "kind": "design",
          "revision": "c07c049c",
          "locator": "docs/internal/design/harness-adapter-seam.md:303-449"
        },
        {
          "id": "auth-runbook-2026-08-17",
          "kind": "runbook",
          "revision": "2026-08-17",
          "locator": "mission-control/playbooks/codex-hermes-auth-runbook.md:77-159"
        },
        {
          "id": "hermes-binding-d724",
          "kind": "repo",
          "revision": "d72408e7",
          "locator": "apps/ctower-runner/src/ctower_runner/hermes/binding.py"
        },
        {
          "id": "claude-binding-d724",
          "kind": "repo",
          "revision": "d72408e7",
          "locator": "apps/ctower-runner/src/ctower_runner/claude_code/binding.py"
        },
        {
          "id": "codex-candidate-ee197",
          "kind": "repo",
          "revision": "ee197705b9503e4e8e86c2a39f83db0878bb986e",
          "locator": "apps/ctower-runner/src/ctower_runner/codex/binding.py; PR #539 reviewed-at revision (OPEN, not landed on origin/main; not the current PR head)"
        },
        {
          "id": "qwen-cli-0215",
          "kind": "binary",
          "revision": "0.21.5",
          "locator": "/home/agent/.local/bin/qwen; qwen --version and qwen --help"
        },
        {
          "id": "qwen-docs-0215",
          "kind": "installed-doc",
          "revision": "0.21.5",
          "locator": "/home/agent/.local/lib/qwen-code/lib/bundled/qc-helper/docs/configuration/{auth,model-providers,settings}.md"
        },
        {
          "id": "local-command-absence",
          "kind": "absence-probe",
          "revision": "2026-08-20T14:24:08Z",
          "locator": "command -v openclaw qwen-code zcode deepseek"
        },
        {
          "id": "ctower-weight-registry-d724",
          "kind": "repo",
          "revision": "d72408e7",
          "locator": "packages/ctower-kernel/src/ctower_kernel/pools/topology.py:89-95"
        }
      ],
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/source" }
    },
    "questions": {
      "type": "array",
      "const": [
        { "id": "native_pool", "prompt": "Does the candidate ship a native credential pool?" },
        {
          "id": "native_fallback",
          "prompt": "Does the candidate ship a native credential/provider fallback?"
        },
        {
          "id": "config_surface",
          "prompt": "What is the config surface, and is it authored-config-only?"
        },
        {
          "id": "identity_proof",
          "prompt": "What proves credential identity: a decodable claim, account file, or nothing?"
        },
        {
          "id": "reset_window_semantics",
          "prompt": "What are the reset or window semantics?"
        },
        {
          "id": "rotation_cache_semantics",
          "prompt": "What cache or restart semantics apply after rotation?"
        },
        {
          "id": "subagent_credential_inheritance",
          "prompt": "How do subagents inherit or acquire credentials?"
        },
        {
          "id": "egress_topology",
          "prompt": "Is egress shared across entries or isolated per entry?"
        },
        {
          "id": "probe_target",
          "prompt": "Which product, endpoint, and model does a representative probe measure?"
        },
        {
          "id": "credit_weights",
          "prompt": "Where are per-model, per-direction credit weights published?"
        }
      ],
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/question" }
    },
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/candidate" },
      "allOf": [
        {
          "contains": { "required": ["key"], "properties": { "key": { "const": "openclaw" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "required": ["key"], "properties": { "key": { "const": "qwen-code" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "required": ["key"], "properties": { "key": { "const": "zcode" } } },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": { "required": ["key"], "properties": { "key": { "const": "deepseek" } } },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    }
  },
  "$defs": {
    "unverified-answer": {
      "type": "object",
      "required": ["state", "value"],
      "properties": { "state": { "const": "unverified" }, "value": { "const": null } }
    },
    "persisted-device-key-answer": {
      "type": "object",
      "required": ["state", "value"],
      "properties": {
        "state": { "const": "verified" },
        "value": { "const": "persisted_device_key" }
      }
    },
    "model-fallback-only-answer": {
      "type": "object",
      "required": ["state", "value"],
      "properties": {
        "state": { "const": "verified" },
        "value": { "const": "model_fallback_only" }
      }
    },
    "env-overridable-answer": {
      "type": "object",
      "required": ["state", "value"],
      "properties": {
        "state": { "const": "verified" },
        "value": { "const": "env_overridable" }
      }
    },
    "weekly-plan-answer": {
      "type": "object",
      "required": ["state", "value"],
      "properties": {
        "state": { "const": "verified" },
        "value": { "const": "weekly_plan" }
      }
    },
    "model-answer": {
      "type": "object",
      "required": ["state", "value"],
      "properties": { "state": { "const": "not_applicable" }, "value": { "const": "model" } }
    },
    "source-id": {
      "enum": [
        "spec-ct-i1-044",
        "design-seam-c07",
        "auth-runbook-2026-08-17",
        "hermes-binding-d724",
        "claude-binding-d724",
        "codex-candidate-ee197",
        "qwen-cli-0215",
        "qwen-docs-0215",
        "local-command-absence",
        "ctower-weight-registry-d724"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "revision", "locator"],
      "properties": {
        "id": {
          "$ref": "#/$defs/source-id"
        },
        "kind": {
          "enum": ["repo", "design", "runbook", "binary", "installed-doc", "absence-probe"]
        },
        "revision": { "type": "string", "minLength": 1, "maxLength": 128 },
        "locator": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt"],
      "properties": {
        "id": {
          "enum": [
            "native_pool",
            "native_fallback",
            "config_surface",
            "identity_proof",
            "reset_window_semantics",
            "rotation_cache_semantics",
            "subagent_credential_inheritance",
            "egress_topology",
            "probe_target",
            "credit_weights"
          ]
        },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "evidence", "note"],
      "properties": {
        "state": { "enum": ["verified", "not_applicable", "unverified"] },
        "value": { "type": ["boolean", "string", "null"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source-id" }
        },
        "note": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "allOf": [
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "const": "unverified" } }
          },
          "then": { "properties": { "value": { "type": "null" } } }
        },
        {
          "if": {
            "required": ["state"],
            "properties": { "state": { "enum": ["verified", "not_applicable"] } }
          },
          "then": { "properties": { "value": { "type": ["boolean", "string"] } } }
        }
      ]
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["refused", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "capability_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "evidence", "reason"],
      "properties": {
        "liveness": {
          "type": "string",
          "pattern": "^(unknown|inherited:[a-z][a-z0-9_.-]{2,127})$"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/source-id" }
        },
        "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "classification",
        "effective_route",
        "adapter_work",
        "role_disposition",
        "registration",
        "capability_declaration",
        "answers"
      ],
      "properties": {
        "key": { "enum": ["openclaw", "qwen-code", "zcode", "deepseek"] },
        "classification": {
          "enum": ["harness_gateway_routed", "harness_baseline", "harness_stub", "model"]
        },
        "effective_route": {
          "enum": ["gateway", "qwen-cli", "unbound-stub", "hermes-profile"]
        },
        "adapter_work": { "enum": ["blocked_until_survey", "zero"] },
        "role_disposition": { "enum": ["undecidable", "not_applicable"] },
        "registration": { "$ref": "#/$defs/registration" },
        "capability_declaration": { "$ref": "#/$defs/capability_declaration" },
        "answers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "native_pool",
            "native_fallback",
            "config_surface",
            "identity_proof",
            "reset_window_semantics",
            "rotation_cache_semantics",
            "subagent_credential_inheritance",
            "egress_topology",
            "probe_target",
            "credit_weights"
          ],
          "properties": {
            "native_pool": { "$ref": "#/$defs/answer" },
            "native_fallback": { "$ref": "#/$defs/answer" },
            "config_surface": { "$ref": "#/$defs/answer" },
            "identity_proof": { "$ref": "#/$defs/answer" },
            "reset_window_semantics": { "$ref": "#/$defs/answer" },
            "rotation_cache_semantics": { "$ref": "#/$defs/answer" },
            "subagent_credential_inheritance": { "$ref": "#/$defs/answer" },
            "egress_topology": { "$ref": "#/$defs/answer" },
            "probe_target": { "$ref": "#/$defs/answer" },
            "credit_weights": { "$ref": "#/$defs/answer" }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "openclaw" } } },
          "then": {
            "properties": {
              "answers": {
                "properties": {
                  "native_pool": { "$ref": "#/$defs/unverified-answer" },
                  "native_fallback": { "$ref": "#/$defs/unverified-answer" },
                  "config_surface": { "$ref": "#/$defs/unverified-answer" },
                  "identity_proof": { "$ref": "#/$defs/persisted-device-key-answer" },
                  "reset_window_semantics": { "$ref": "#/$defs/unverified-answer" },
                  "rotation_cache_semantics": { "$ref": "#/$defs/unverified-answer" },
                  "subagent_credential_inheritance": { "$ref": "#/$defs/unverified-answer" },
                  "egress_topology": { "$ref": "#/$defs/unverified-answer" },
                  "probe_target": { "$ref": "#/$defs/unverified-answer" },
                  "credit_weights": { "$ref": "#/$defs/unverified-answer" }
                }
              },
              "classification": { "const": "harness_gateway_routed" },
              "effective_route": { "const": "gateway" },
              "adapter_work": { "const": "blocked_until_survey" },
              "role_disposition": { "const": "undecidable" },
              "registration": { "properties": { "status": { "const": "refused" } } },
              "capability_declaration": { "properties": { "liveness": { "const": "unknown" } } }
            }
          }
        },
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "qwen-code" } } },
          "then": {
            "properties": {
              "answers": {
                "properties": {
                  "native_pool": { "$ref": "#/$defs/unverified-answer" },
                  "native_fallback": { "$ref": "#/$defs/model-fallback-only-answer" },
                  "config_surface": { "$ref": "#/$defs/env-overridable-answer" },
                  "identity_proof": { "$ref": "#/$defs/unverified-answer" },
                  "reset_window_semantics": { "$ref": "#/$defs/weekly-plan-answer" },
                  "rotation_cache_semantics": { "$ref": "#/$defs/unverified-answer" },
                  "subagent_credential_inheritance": { "$ref": "#/$defs/unverified-answer" },
                  "egress_topology": { "$ref": "#/$defs/unverified-answer" },
                  "probe_target": { "$ref": "#/$defs/unverified-answer" },
                  "credit_weights": { "$ref": "#/$defs/unverified-answer" }
                }
              },
              "classification": { "const": "harness_baseline" },
              "effective_route": { "const": "qwen-cli" },
              "adapter_work": { "const": "blocked_until_survey" },
              "role_disposition": { "const": "undecidable" },
              "registration": { "properties": { "status": { "const": "refused" } } },
              "capability_declaration": { "properties": { "liveness": { "const": "unknown" } } }
            }
          }
        },
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "zcode" } } },
          "then": {
            "properties": {
              "answers": {
                "properties": {
                  "native_pool": { "$ref": "#/$defs/unverified-answer" },
                  "native_fallback": { "$ref": "#/$defs/unverified-answer" },
                  "config_surface": { "$ref": "#/$defs/unverified-answer" },
                  "identity_proof": { "$ref": "#/$defs/unverified-answer" },
                  "reset_window_semantics": { "$ref": "#/$defs/unverified-answer" },
                  "rotation_cache_semantics": { "$ref": "#/$defs/unverified-answer" },
                  "subagent_credential_inheritance": { "$ref": "#/$defs/unverified-answer" },
                  "egress_topology": { "$ref": "#/$defs/unverified-answer" },
                  "probe_target": { "$ref": "#/$defs/unverified-answer" },
                  "credit_weights": { "$ref": "#/$defs/unverified-answer" }
                }
              },
              "classification": { "const": "harness_stub" },
              "effective_route": { "const": "unbound-stub" },
              "adapter_work": { "const": "blocked_until_survey" },
              "role_disposition": { "const": "undecidable" },
              "registration": { "properties": { "status": { "const": "refused" } } },
              "capability_declaration": { "properties": { "liveness": { "const": "unknown" } } }
            }
          }
        },
        {
          "if": { "required": ["key"], "properties": { "key": { "const": "deepseek" } } },
          "then": {
            "properties": {
              "answers": {
                "properties": {
                  "native_pool": { "$ref": "#/$defs/model-answer" },
                  "native_fallback": { "$ref": "#/$defs/model-answer" },
                  "config_surface": { "$ref": "#/$defs/model-answer" },
                  "identity_proof": { "$ref": "#/$defs/model-answer" },
                  "reset_window_semantics": { "$ref": "#/$defs/model-answer" },
                  "rotation_cache_semantics": { "$ref": "#/$defs/model-answer" },
                  "subagent_credential_inheritance": { "$ref": "#/$defs/model-answer" },
                  "egress_topology": { "$ref": "#/$defs/model-answer" },
                  "probe_target": { "$ref": "#/$defs/model-answer" },
                  "credit_weights": { "$ref": "#/$defs/unverified-answer" }
                }
              },
              "classification": { "const": "model" },
              "effective_route": { "const": "hermes-profile" },
              "adapter_work": { "const": "zero" },
              "role_disposition": { "const": "not_applicable" },
              "registration": { "properties": { "status": { "const": "not_applicable" } } },
              "capability_declaration": {
                "properties": { "liveness": { "const": "inherited:hermes.gateway_log" } }
              }
            }
          }
        }
      ]
    }
  }
}
