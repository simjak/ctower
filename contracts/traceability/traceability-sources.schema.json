{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.invalid/contracts/traceability/traceability-sources.schema.json",
  "title": "Authored contract traceability sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifacts"],
  "properties": {
    "schema": {"const": "ctower.traceability-sources/v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "references"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(contracts|packs)/[A-Za-z0-9._/-]+$"
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(SPEC#[a-z0-9][a-z0-9-]*|INV-[0-9]{2}|AC-[A-Z0-9]+-[0-9]{2})$"
          }
        }
      }
    }
  }
}
