{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/project.schema.json",
  "title": "ProjectComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "display_name", "repository_ref", "goal_refs"],
  "properties": {
    "schema": { "const": "ctower.project/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "repository_ref": {
      "type": "string",
      "pattern": "^repository:[a-z][a-z0-9._/-]{2,255}$"
    },
    "goal_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}@[1-9][0-9]*$" },
      "uniqueItems": true
    }
  }
}
