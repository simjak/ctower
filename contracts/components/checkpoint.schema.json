{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/checkpoint.schema.json",
  "title": "CheckpointComponent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "key",
    "checkpoint_key",
    "display_name",
    "outcome",
    "accountable_owner",
    "criteria",
    "dependency_refs"
  ],
  "properties": {
    "schema": {
      "const": "ctower.checkpoint/v1"
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "checkpoint_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "accountable_owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "dependency_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{2,127}@[1-9][0-9]*$"
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "description",
        "required",
        "evidence_policy_refs"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,95}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required": {
          "const": true
        },
        "evidence_policy_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{2,127}@[1-9][0-9]*$"
          }
        },
        "proof_link": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ticket_id", "criterion_key"],
          "properties": {
            "ticket_id": {"type": "string", "format": "uuid"},
            "criterion_key": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]*$"
            }
          }
        },
        "assigned_seat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seat_key", "catalog_key", "catalog_revision", "catalog_digest"],
          "properties": {
            "seat_key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"},
            "catalog_key": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
            "catalog_revision": {"type": "integer", "minimum": 1},
            "catalog_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      }
    }
  }
}
