{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/image.schema.json",
  "title": "ImageComponent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "key", "digest", "environment_ref", "reusable_state", "execution"
  ],
  "properties": {
    "schema": { "const": "ctower.image/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "environment_ref": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}@[1-9][0-9]*$" },
    "reusable_state": { "const": "secret_free" },
    "execution": { "const": "not_exercised" }
  }
}
