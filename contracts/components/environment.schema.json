{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/environment.schema.json",
  "title": "EnvironmentComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "platform", "architecture", "runtime", "effects"],
  "properties": {
    "schema": { "const": "ctower.environment/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "platform": { "type": "string", "enum": ["linux", "macos", "windows"] },
    "architecture": { "type": "string", "enum": ["x86_64", "aarch64"] },
    "runtime": { "type": "string", "minLength": 1, "maxLength": 80 },
    "effects": { "const": "not_exercised" }
  }
}
