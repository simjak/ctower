{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/skill.schema.json",
  "title": "SkillComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "display_name", "instructions_digest", "capability_refs"],
  "properties": {
    "schema": { "const": "ctower.skill/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "instructions_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "capability_refs": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}@[1-9][0-9]*$" },
      "uniqueItems": true
    }
  }
}
