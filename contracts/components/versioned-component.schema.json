{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/versioned-component.schema.json",
  "title": "VersionedComponent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "key",
    "scope",
    "revision",
    "content_digest",
    "schema_ref",
    "lifecycle",
    "compatibility",
    "provenance",
    "payload_ref"
  ],
  "properties": {
    "schema": { "const": "ctower.versioned-component/v1" },
    "kind": {
      "type": "string",
      "enum": [
        "workflow",
        "execution_policy",
        "gate_policy",
        "evidence_policy",
        "goal",
        "project",
        "agent_profile",
        "persona",
        "skill",
        "tool",
        "capability",
        "environment",
        "image",
        "harness",
        "supervisor",
        "target",
        "workspace",
        "telemetry",
        "placement_policy",
        "extension",
        "cadence_policy",
        "notification",
        "integration",
        "adapter"
      ]
    },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant", "project"],
      "properties": {
        "tenant": { "type": "string", "minLength": 1 },
        "project": { "type": ["string", "null"] }
      }
    },
    "revision": { "type": "integer", "minimum": 1 },
    "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "schema_ref": { "type": "string", "minLength": 1 },
    "lifecycle": { "type": "string", "enum": ["draft", "published", "deprecated", "revoked"] },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ctower", "requires"],
      "properties": {
        "ctower": { "type": "string", "minLength": 1 },
        "requires": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentReference" },
          "uniqueItems": true
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source", "digest"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        }
      }
    },
    "supersedes": { "anyOf": [{ "$ref": "#/$defs/componentReference" }, { "type": "null" }] },
    "payload_ref": { "type": "string", "pattern": "^object:sha256:[a-f0-9]{64}$" }
  },
  "$defs": {
    "componentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "key", "revision", "content_digest"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "content_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
