{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/harness.schema.json",
  "title": "HarnessComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "adapter", "capabilities", "execution"],
  "properties": {
    "schema": { "const": "ctower.harness/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
      "uniqueItems": true
    },
    "execution": { "const": "not_exercised" }
  }
}
