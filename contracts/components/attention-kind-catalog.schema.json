{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/attention-kind-catalog.schema.json",
  "title": "AttentionKindCatalogComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "display_name", "members"],
  "properties": {
    "schema": {"const": "ctower.attention-kind-catalog/v1"},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/member"}
    }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,95}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    }
  }
}
