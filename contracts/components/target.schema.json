{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/target.schema.json",
  "title": "TargetComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "environment_ref", "image_ref", "network", "execution"],
  "properties": {
    "schema": { "const": "ctower.target/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "environment_ref": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}@[1-9][0-9]*$" },
    "image_ref": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}@[1-9][0-9]*$" },
    "network": { "const": "local_only" },
    "execution": { "const": "not_exercised" }
  }
}
