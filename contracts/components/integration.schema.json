{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/integration.schema.json",
  "title": "IntegrationComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "adapter", "authority", "execution"],
  "properties": {
    "schema": { "const": "ctower.integration/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "authority": { "const": "reference_only" },
    "execution": { "const": "not_exercised" }
  }
}
