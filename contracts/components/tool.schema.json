{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/tool.schema.json",
  "title": "ToolComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "display_name", "capability", "authority"],
  "properties": {
    "schema": { "const": "ctower.tool/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
    "authority": { "const": "requested_not_granted" }
  }
}
