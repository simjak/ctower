{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ctower.local/contracts/components/goal.schema.json",
  "title": "GoalComponent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "key", "display_name", "outcome", "success_criteria"],
  "properties": {
    "schema": { "const": "ctower.goal/v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
    "display_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "outcome": { "type": "string", "minLength": 1, "maxLength": 500 },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 },
      "uniqueItems": true
    }
  }
}
